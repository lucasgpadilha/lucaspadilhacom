---
import Brand from './Brand.astro';

const links = [
  { href: '#tratamentos', label: 'Tratamentos' },
  { href: '#primeira-consulta', label: 'Primeira consulta' },
  { href: '#medo', label: 'Medo de dentista' },
  { href: '#duvidas', label: 'Dúvidas' },
  { href: '#visite', label: 'Horários e local' },
];
---
<header class="hd" id="topo">
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>
  <div class="wrap hd__in">
    <Brand />
    <nav class="nav" aria-label="Principal">
      <ul class="nav__list" role="list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <details class="nav__menu">
        <summary>
          <span class="burger" aria-hidden="true"></span>
          <span class="menu-word">Menu</span>
        </summary>
        <ul role="list">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a class="btn" href="/sites/#contato">Agendar avaliação</a></li>
        </ul>
      </details>
    </nav>
    <a class="btn btn--ghost hd__cta" href="/sites/#contato">Agendar avaliação</a>
  </div>
</header>

<style>
  .hd { position: relative; z-index: 20; }
  .hd__in {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    min-height: 76px;
  }
  .nav__list { display: none; }
  .hd__cta { display: none; }

  .nav__menu summary {
    display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 18px;
    border: 1px solid var(--line-strong); border-radius: 999px;
    font-size: 0.9375rem; font-weight: 600; color: var(--ink); cursor: pointer; list-style: none;
  }
  .nav__menu summary::-webkit-details-marker { display: none; }
  .burger, .burger::before {
    display: block; width: 16px; height: 1.5px; background: currentColor; border-radius: 2px;
  }
  .burger { position: relative; top: -3px; }
  .burger::before { content: ''; position: relative; top: 6px; width: 11px; }
  .nav__menu[open] summary { background: var(--mint); border-color: var(--mint); }
  .nav__menu ul {
    position: absolute; left: var(--gutter); right: var(--gutter); top: calc(100% - 4px);
    display: grid; gap: 2px; padding: 12px;
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg);
    box-shadow: 0 18px 40px -24px rgb(36 32 28 / 0.35);
  }
  .nav__menu:not([open]) ul { display: none; }
  .nav__menu ul a:not(.btn) {
    display: flex; align-items: center; min-height: 48px; padding: 0 14px; border-radius: 14px;
    color: var(--ink); font-weight: 520; text-decoration: none;
  }
  .nav__menu ul a:not(.btn):hover { background: var(--mint); }
  .nav__menu .btn { width: 100%; margin-top: 8px; }

  @media (max-width: 399px) {
    .nav__menu summary { width: 44px; padding: 0; justify-content: center; }
    .menu-word {
      position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
    }
  }
  @media (min-width: 640px) {
    .hd__cta { display: inline-flex; }
    .nav { margin-left: auto; }
  }
  @media (min-width: 1080px) {
    .hd__in { min-height: 92px; }
    .nav__menu { display: none; }
    .nav { margin-left: auto; margin-right: 8px; }
    .nav__list { display: flex; gap: 4px; }
    .nav__list a {
      display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px;
      color: var(--ink); font-size: 0.9375rem; font-weight: 500; text-decoration: none;
      border-radius: 999px;
    }
    .nav__list a:hover { color: var(--teal); text-decoration: underline; text-underline-offset: 0.3em; text-decoration-thickness: 1px; }
  }
</style>
