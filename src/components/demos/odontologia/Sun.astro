---
/**
 * The Aurora signature: a sun rising over a horizon, drawn as four flat concentric bands.
 * Used twice on the page (hero, closing panel) and, tiny, in the logo mark.
 */
---
<svg class="sun" viewBox="0 0 400 200" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
  <circle cx="200" cy="200" r="200" fill="#FCE7DF" />
  <circle cx="200" cy="200" r="152" fill="#F9CBBB" />
  <circle cx="200" cy="200" r="106" fill="#F5A68F" />
  <circle cx="200" cy="200" r="62" fill="#F07F65" />
</svg>

<style>
  .sun { display: block; width: 100%; height: auto; overflow: visible; }
</style>
