---
import Photo from './Photo.astro';
import Arrow from './Arrow.astro';

const rows = [
  {
    name: 'Clareamento',
    meta: 'No consultório ou em casa, supervisionado',
    text: 'Com moldeiras feitas para você e acompanhamento a cada etapa. Só indicamos depois de avaliar dentes, gengivas e restaurações antigas.',
  },
  {
    name: 'Alinhadores e ortodontia',
    meta: 'Adolescentes e adultos',
    text: 'Aparelho fixo ou alinhadores transparentes. A indicação vem depois da documentação ortodôntica, com o plano e a duração estimada por escrito.',
  },
  {
    name: 'Implantes',
    meta: 'Planejado por etapas',
    text: 'Planejamento com exames de imagem, cirurgia em fases e acompanhamento depois da instalação. Você sabe de antemão quantas consultas cada fase pede.',
  },
];
---
<section class="section trat" id="tratamentos" aria-labelledby="trat-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2 id="trat-title" class="h2">Do check-up ao implante, <strong>no mesmo lugar<span class="dot">.</span></strong></h2>
      </div>
      <p class="sec-head__aside">
        Todo tratamento começa por uma avaliação. Você recebe as opções por escrito, com as
        etapas explicadas, e decide no seu tempo.
      </p>
    </div>

    <article class="feat">
      <div class="feat__photo frame">
        <Photo name="instrumentos" tone="warm" sizes="(min-width: 1360px) 400px, (min-width: 960px) 30vw, calc(100vw - 64px)" />
      </div>
      <div class="feat__body">
        <h3 class="feat__title">Clínica geral e prevenção</h3>
        <p class="feat__meta">Por onde quase tudo começa</p>
        <p class="feat__text">
          O acompanhamento de rotina de dentes e gengivas, e o lugar onde a gente se conhece.
          O intervalo entre as consultas é combinado com você, conforme o que a sua boca pede.
        </p>
        <ul class="feat__list" role="list">
          <li>Check-up e limpeza</li>
          <li>Restaurações</li>
          <li>Tratamento de gengiva</li>
          <li>Tratamento de canal</li>
          <li>Placa para bruxismo</li>
          <li>Orientação de higiene em casa</li>
        </ul>
      </div>
    </article>

    <div class="split">
      <div class="rows">
        {rows.map((r) => (
          <article class="row">
            <h3 class="row__name">{r.name}</h3>
            <p class="row__meta">{r.meta}</p>
            <p class="row__text">{r.text}</p>
          </article>
        ))}
      </div>

      <article class="kids">
        <h3 class="kids__title">Odontopediatria</h3>
        <p class="kids__meta">Para os pequenos</p>
        <p>
          Do primeiro dentinho à adolescência. A consulta vai no ritmo da criança, com os pais
          por perto e muita conversa antes de qualquer instrumento.
        </p>
        <ul class="kids__list" role="list">
          <li>Escovação ensinada no espelho, com a criança</li>
          <li>Flúor e selantes, quando indicados</li>
          <li>Conversa com os pais sobre chupeta e alimentação</li>
        </ul>
        <p class="kids__note">
          A primeira visita pode ser só para conhecer a cadeira que sobe e desce e a escova que gira.
        </p>
      </article>
    </div>

    <article class="urg">
      <div class="urg__photo">
        <Photo name="cuidado" tone="warm" position="60% 40%" sizes="(min-width: 1360px) 460px, (min-width: 960px) 34vw, calc(100vw - 64px)" />
      </div>
      <div class="urg__copy">
        <h3 class="urg__title">Urgência</h3>
        <p class="urg__meta">Dor ou acidente</p>
        <p class="urg__text">
          Dor de dente, dente quebrado, restauração que caiu ou rosto inchado? Mande uma mensagem.
          De segunda a sábado, a agenda tem horários reservados para encaixar quem precisa.
        </p>
        <a class="btn btn--light" href="/sites/#contato">Pedir um encaixe <Arrow /></a>
      </div>
    </article>
  </div>
</section>

<style>
  .feat {
    display: grid; gap: 28px; margin-top: 48px; padding: 16px;
    background: var(--mint); border-radius: var(--r-lg);
  }
  .feat__photo { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r); }
  /* morning light: a faint cream-to-coral wash over the two cool photos */
  .feat__photo::after, .urg__photo::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(200deg, rgb(251 250 247 / 0.22), rgb(240 127 101 / 0.1) 70%);
  }
  .feat__body { padding: 0 8px 12px; }
  .feat__meta, .kids__meta, .urg__meta { margin-top: 8px; font-size: 0.9375rem; font-weight: 600; color: var(--teal); }
  .feat__title {
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.625rem); font-weight: 340;
    letter-spacing: -0.03em; line-height: 1.08; color: var(--ink);
  }
  .feat__text { margin-top: 16px; max-width: 46ch; color: var(--ink-2); }
  .feat__list {
    display: grid; gap: 0; margin-top: 24px; border-top: 1px solid var(--mint-line);
  }
  .feat__list li {
    display: flex; align-items: center; gap: 12px; min-height: 48px;
    border-bottom: 1px solid var(--mint-line); font-weight: 520; color: var(--ink);
  }
  .feat__list li::before {
    content: ''; flex: none; width: 7px; height: 7px; border-radius: 50%; border: 1.5px solid var(--teal);
  }

  .split { display: grid; gap: 40px; margin-top: 56px; }
  .row {
    display: grid; gap: 6px; padding: 26px 0 28px; border-top: 1px solid var(--line);
  }
  .row:last-child { border-bottom: 1px solid var(--line); }
  .row__name { font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem); font-weight: 620; letter-spacing: -0.02em; color: var(--ink); }
  .row__meta { font-size: 0.875rem; font-weight: 600; color: var(--teal); }
  .row__text { margin-top: 6px; max-width: 52ch; color: var(--ink-2); }

  .kids {
    align-self: start; padding: 32px 28px 30px;
    background: var(--blush); border-radius: var(--r-lg);
  }
  .kids__meta { color: var(--coral-ink); }
  .kids__title {
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem); font-weight: 340;
    letter-spacing: -0.03em; line-height: 1.08; color: var(--ink);
  }
  .kids p:not([class]) { margin-top: 14px; color: var(--ink); }
  .kids__list { margin-top: 22px; }
  .kids__list li {
    display: flex; gap: 12px; align-items: baseline; padding: 10px 0;
    border-top: 1px solid rgb(166 67 44 / 0.18); font-size: 0.9375rem; font-weight: 520; color: var(--ink);
  }
  .kids__list li::before {
    content: ''; flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--coral);
    transform: translateY(-1px);
  }
  .kids__note {
    margin-top: 22px; padding-top: 18px; border-top: 1px solid rgb(166 67 44 / 0.22);
    font-size: 0.9375rem; color: var(--ink-2);
  }

  .urg {
    display: grid; gap: 28px; margin-top: 56px; padding: 16px 16px 32px;
    background: var(--teal); color: #fff; border-radius: var(--r-lg);
  }
  .urg__photo { position: relative; overflow: hidden; aspect-ratio: 16 / 10; border-radius: var(--r); background: var(--teal-deep); }
  .urg__copy { padding: 0 8px; }
  .urg__meta { color: var(--on-teal-2); }
  .urg__title { font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.75rem); font-weight: 340; letter-spacing: -0.03em; }
  .urg__text { margin-top: 12px; max-width: 48ch; color: var(--on-teal-2); }
  .urg .btn { margin-top: 24px; }

  @media (min-width: 720px) {
    .feat__list { grid-template-columns: 1fr 1fr; column-gap: 28px; }
  }
  @media (min-width: 960px) {
    .feat {
      grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 32px; align-items: center;
      margin-top: 64px; padding: 20px;
    }
    .feat__photo { grid-column: 1 / 5; aspect-ratio: 1 / 1; }
    .feat__body { grid-column: 5 / 13; padding: 24px 36px 24px 16px; }
    .split { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 32px; margin-top: 88px; }
    .rows { grid-column: 1 / 8; }
    .row { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); grid-template-rows: auto 1fr; align-content: start; column-gap: 32px; padding: 30px 0 32px; }
    .row__name, .row__meta { grid-column: 1; }
    .row__text { grid-column: 2; grid-row: 1 / span 2; margin-top: 0; }
    .kids { grid-column: 8 / 13; align-self: stretch; display: flex; flex-direction: column; padding: 40px 40px 36px; }
    .kids__list { margin-bottom: 32px; }
    .kids__note { margin-top: auto; }
    .urg {
      grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 32px; align-items: center;
      margin-top: 88px; padding: 20px;
    }
    .urg__photo { grid-column: 8 / 13; grid-row: 1; aspect-ratio: 3 / 2; }
    .urg__copy { grid-column: 1 / 7; grid-row: 1; padding: 36px 0 36px 40px; }
  }
</style>
