---
const links = [
  { href: '#cardapio', label: 'Cardápio' },
  { href: '#fornadas', label: 'Fornadas' },
  { href: '#encomendas', label: 'Encomendas' },
  { href: '#visite', label: 'Visite' },
];
---
<header class="top">
  <div class="cj-wrap top-row">
    <a class="brand" href="#topo" aria-label="Casa Jabuticaba, início">
      <span class="cj-dot brand-dot" aria-hidden="true"></span>
      <span class="brand-name">Casa Jabuticaba</span>
    </a>
    <nav class="nav" aria-label="Seções">
      <ul role="list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .top { position: relative; z-index: 5; }
  .top-row {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    column-gap: 2rem; padding-block: 0.5rem 0;
    border-bottom: 1px solid rgb(43 21 48 / 0.16);
  }
  .brand {
    display: inline-flex; align-items: center; gap: 0.55rem; min-height: 48px;
    color: var(--jabuticaba); text-decoration: none;
    font-family: var(--display); font-weight: 680; font-size: 1.375rem; letter-spacing: -0.01em;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 36;
  }
  .brand-dot { width: 0.82em; height: 0.82em; }
  .nav { width: calc(100% + 1.2rem); margin-inline: -0.6rem; }
  .nav ul { display: flex; flex-wrap: wrap; gap: 0; margin: 0; padding: 0; list-style: none; }
  .nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.6rem;
    font-size: 0.9375rem; font-weight: 520; color: var(--tinta); text-decoration: none;
    text-decoration-thickness: 2px; text-underline-offset: 0.35em; text-decoration-color: var(--crosta);
  }
  .nav a:hover { text-decoration-line: underline; }
  @media (max-width: 380px) {
    .nav { width: calc(100% + 0.4rem); margin-inline: -0.2rem; }
    .nav ul { justify-content: space-between; }
    .nav a { padding: 0 0.2rem; font-size: 0.875rem; }
  }
  @media (min-width: 760px) {
    .top-row { flex-wrap: nowrap; padding-block: 0.75rem; }
    .nav { width: auto; margin: 0 -0.75rem 0 0; }
    .nav a { padding: 0 0.75rem; font-size: 1rem; }
    .brand { font-size: 1.5rem; }
  }
</style>
