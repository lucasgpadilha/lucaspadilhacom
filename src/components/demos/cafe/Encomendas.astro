---
import Photo from './Photo.astro';

const prazos = [
  { n: '2', what: 'Bolos de vó inteiros, caixas de pão de queijo e cestas de café da manhã.' },
  { n: '5', what: 'Bolos de aniversário recheados e decorados.' },
  { n: '10', what: 'Festas com mais de 40 pessoas e qualquer data de dezembro.' },
];

const itens = [
  { name: 'Bolo de vó inteiro', desc: 'Forma de 22 cm, rende 12 fatias.', price: '78', from: true },
  { name: 'Bolo de aniversário', desc: 'Redondo de 20 cm, recheado, para até 20 pessoas.', price: '190', from: true },
  { name: 'Caixa de mini pão de queijo', desc: '50 unidades, assadas ou congeladas.', price: '89' },
  { name: 'Cesta de café da manhã', desc: 'Para dois: pães, bolo, geleia, manteiga e café.', price: '165' },
];

const passos = [
  'Escolha o bolo, o sabor e o tamanho.',
  'Mande a data, o horário e quantas pessoas vão comer.',
  'A gente confirma o valor e reserva com um sinal de 50%.',
  'Retire no balcão ou receba por delivery na região.',
];
---
<section id="encomendas" class="encomendas" aria-labelledby="encomendas-title">
  <div class="cj-wrap enc-grid">
    <div class="enc-intro">
      <p class="cj-eyebrow">Aniversários, reuniões e cafés de domingo</p>
      <h2 id="encomendas-title" class="cj-h2">Encomendas</h2>
      <p class="cj-lead">
        Bolo de aniversário com gosto de casa de vó, caixa de pão de queijo para a reunião,
        cesta de café da manhã para quem você gosta. Peça com antecedência que a gente capricha.
      </p>
    </div>

    <div class="enc-media">
      <figure class="enc-fig">
        <div class="enc-photo">
          <Photo slot="bolo" sizes="(min-width: 1080px) 72vw, (min-width: 600px) 61rem, 170vw" tone="crosta" />
        </div>
        <figcaption class="enc-cap">Chocolate da casa <span>na forma de furo</span></figcaption>
      </figure>
      <p class="enc-sticker" aria-hidden="true"><span>peça com</span><b>48h</b><span>de prazo</span></p>
    </div>

    <div class="enc-body">

      <h3 class="enc-sub first">Com quanto tempo pedir</h3>
      <dl class="prazos">
        {prazos.map((p) => (
          <div class="prazo">
            <dt><span class="prazo-n">{p.n}</span> <span class="prazo-u">dias antes</span></dt>
            <dd>{p.what}</dd>
          </div>
        ))}
      </dl>

      <h3 class="enc-sub">O que sai sob encomenda</h3>
      <ul class="cj-menu" role="list">
        {itens.map((it) => (
          <li class="cj-item">
            <p class="cj-line">
              <span class="cj-name">{it.name}</span>
              <span class="cj-leader" aria-hidden="true"></span>
              <span class="cj-price">{it.from && <span class="cj-from">a partir de </span>}<small>R$</small>{it.price}</span>
            </p>
            <p class="cj-desc">{it.desc}</p>
          </li>
        ))}
      </ul>

      <h3 class="enc-sub">Como funciona</h3>
      <ol class="passos" role="list">
        {passos.map((p, i) => <li><span class="passo-n" aria-hidden="true">{i + 1}</span>{p}</li>)}
      </ol>

      <div class="enc-cta">
        <a class="cj-btn" href="/sites/#contato">
          Fazer encomenda
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .encomendas { padding-block: clamp(4.5rem, 10vw, 8rem); overflow-x: clip; }
  .enc-grid { display: grid; }
  .enc-media { margin-block: 3rem 1rem; }
  .enc-sub.first { margin-top: 3rem; }

  .enc-media { position: relative; padding: 0.5rem 0.75rem 0; }
  .enc-fig { position: relative; margin: 0; }
  .enc-cap {
    position: absolute; right: -0.25rem; top: 1.25rem; rotate: 4deg; max-width: 13rem;
    padding: 0.55rem 0.9rem 0.6rem; border-radius: 0.35rem;
    background: var(--papel); color: var(--jabuticaba);
    box-shadow: 0 10px 24px -12px rgb(43 21 48 / 0.55), inset 0 0 0 1px rgb(43 21 48 / 0.14);
    font-family: var(--display); font-size: 1.125rem; font-weight: 600; line-height: 1.15; font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }
  .enc-cap span { display: block; font: 600 0.75rem/1.3 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--folha); margin-top: 0.2rem; }
  .enc-photo {
    aspect-ratio: 4 / 5; overflow: hidden; rotate: 1.75deg; background: var(--miolo);
    border-radius: 0.375rem;
    box-shadow: 0 0 0 10px var(--papel), 0 0 0 11px rgb(43 21 48 / 0.18), 0 36px 60px -34px rgb(43 21 48 / 0.6);
  }
  .enc-photo :global(img), .enc-photo :global(.cj-ph) { width: 100%; height: 100%; object-fit: cover; }
  .enc-photo :global(img) { object-position: 64% 55%; }
  .enc-sticker {
    position: absolute; left: -0.25rem; bottom: -1.75rem; width: 7.5rem; aspect-ratio: 1; rotate: -10deg;
    display: grid; place-content: center; text-align: center; border-radius: 50%;
    background: var(--jabuticaba); color: var(--creme);
    box-shadow: 0 0 0 5px var(--creme);
    font-size: 0.75rem; font-weight: 600; line-height: 1.15; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .enc-sticker b { font-family: var(--display); font-size: 2.25rem; font-weight: 650; line-height: 1; letter-spacing: -0.02em; text-transform: none; font-variation-settings: 'SOFT' 100, 'WONK' 1; color: var(--crosta-clara); }

  .enc-sub {
    margin-top: 2.75rem; padding-bottom: 0.6rem; border-bottom: 1px solid rgb(43 21 48 / 0.3);
    font-size: 0.8125rem; font-weight: 650; letter-spacing: 0.12em; text-transform: uppercase; color: var(--folha);
  }
  .prazos { margin: 0; }
  .prazo { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; align-items: baseline; padding-block: 0.9rem; border-bottom: 1px solid rgb(43 21 48 / 0.14); }
  .prazo dt { display: flex; flex-direction: column; }
  .prazo-n {
    font-family: var(--display); font-weight: 600; font-size: 3.25rem; line-height: 0.85; color: var(--crosta-texto);
    letter-spacing: -0.03em; font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }
  .prazo-u { margin-top: 0.35rem; font-size: 0.8125rem; font-weight: 600; color: var(--tinta-2); }
  .prazo dd { margin: 0; font-size: 1rem; line-height: 1.5; }
  .encomendas .cj-menu { margin-top: 1rem; }

  .passos { margin: 1rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.85rem; }
  .passos li { display: grid; grid-template-columns: 2.25rem 1fr; gap: 0.75rem; align-items: baseline; }
  .passo-n {
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%;
    background: var(--jabuticaba); color: var(--creme);
    font-family: var(--display); font-weight: 650; font-size: 1.0625rem; font-variation-settings: 'SOFT' 100, 'WONK' 1;
    translate: 0 0.55rem;
  }
  .passos li { line-height: 1.5; }
  .enc-cta { margin-top: 2.5rem; }

  @media (min-width: 600px) {
    .enc-media { max-width: 34rem; }
    .enc-sticker { width: 9rem; left: -1rem; }
    .enc-sticker b { font-size: 2.75rem; }
  }

  @media (min-width: 1080px) {
    .enc-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); grid-template-rows: auto 1fr; column-gap: clamp(3.5rem, 7vw, 7rem); align-items: start; }
    .enc-media { grid-column: 1; grid-row: 1 / span 2; position: sticky; top: 5rem; max-width: none; margin: 0; padding-top: 1.5rem; }
    .enc-intro, .enc-body { grid-column: 2; }
    .prazo { grid-template-columns: 9rem 1fr; }
    .prazo-n { font-size: 4rem; }
  }
</style>
