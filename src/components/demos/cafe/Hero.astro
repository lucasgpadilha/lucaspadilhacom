---
import Photo from './Photo.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="cj-wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title">
        <span>Pão com tempo,</span>
        <span>café sem pressa</span>
        <span>e <span class="accent">bolo de vó</span><span class="cj-dot title-dot" aria-hidden="true"></span><span class="cj-sr">.</span></span>
      </h1>
      <p class="hero-lead">
        Uma padaria de bairro em Barão Geraldo, Campinas, com o forno aceso desde cedo.
        Pão de fermentação natural, pão de queijo com queijo de verdade, cafés especiais
        coados na hora e aqueles bolos que lembram a casa da avó.
      </p>
      <div class="hero-actions">
        <a class="cj-btn" href="/sites/#contato">
          Fazer encomenda
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a class="cj-textlink" href="#cardapio">Ver o cardápio</a>
      </div>
      <p class="cj-demo-note">Demonstração: no site real, este botão abre o WhatsApp da Casa Jabuticaba.</p>
    </div>

    <div class="hero-media">
      <!-- The arch is the mouth of the oven. With WebGL, the tray bakes in it as the page scrolls; otherwise the photo stays. -->
      <div class="arch" data-oven>
        <div class="arch-photo" data-fallback>
          <Photo slot="pao-de-queijo" sizes="(min-width: 960px) 40vw, (min-width: 600px) 75vw, 110vw" tone="crosta" />
        </div>
      </div>
      <svg class="stamp" viewBox="0 0 120 120" aria-hidden="true">
        <defs><path id="cj-ring" d="M60 60m-43 0a43 43 0 1 1 86 0a43 43 0 1 1-86 0" /></defs>
        <circle class="stamp-bg" cx="60" cy="60" r="59" />
        <g class="stamp-ring">
          <text><textPath href="#cj-ring" textLength="268" lengthAdjust="spacing">fermentação natural · pão de verdade ·</textPath></text>
        </g>
        <circle class="stamp-core" cx="60" cy="60" r="17" />
        <ellipse class="stamp-shine" cx="54" cy="53" rx="5" ry="3.4" transform="rotate(-35 54 53)" />
      </svg>
      <p class="tag">
        <span class="tag-hole" aria-hidden="true"></span>
        <span class="tag-k">Fornada das 10h30</span>
        <span class="tag-v">Pão de queijo <b><small>R$</small>7</b></span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(1.75rem, 4vw, 3.5rem) clamp(3.5rem, 8vw, 6.5rem); overflow-x: clip; background: var(--creme); }
  .hero-grid { display: grid; gap: clamp(2.75rem, 6vw, 4rem); align-items: center; }

  .hero-title {
    font-family: var(--display); font-weight: 620; color: var(--jabuticaba);
    font-size: min(calc((100vw - 2 * var(--gutter)) / 7.25), 6rem);
    line-height: 0.95; letter-spacing: -0.035em;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }
  .hero-title > span { display: block; }
  /* Lines rise from under their own baseline; the mask keeps descenders and the accent dot. */
  .hero-title :global(.hero-line-mask) { padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .accent { color: var(--crosta); font-weight: 700; }
  .title-dot { width: 0.2em; height: 0.2em; margin-left: 0.06em; vertical-align: baseline; }

  .hero-lead { max-width: 34rem; margin-top: 1.5rem; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); line-height: 1.55; color: var(--tinta); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin-top: 2rem; }
  .cj-demo-note { margin-top: 0.85rem; }

  /* The arch is the mouth of the oven: a cream sweep lit warm from the back, where the tray bakes. */
  .hero-media { position: relative; width: 100%; max-width: 34rem; margin-inline: auto; aspect-ratio: 1 / 1.1; }
  .arch {
    position: absolute; top: 0; right: 0; width: 88%; aspect-ratio: 4 / 5; overflow: hidden;
    border-radius: 999px 999px 1.25rem 1.25rem; rotate: 1.5deg;
    background:
      radial-gradient(80% 55% at 30% 20%, #fffaf1 0%, rgb(255 250 241 / 0) 100%),
      linear-gradient(180deg, #f1e3cb 0%, #f6eedf 48%, #f3e6cf 100%);
    box-shadow: 0 0 0 7px var(--creme), 0 0 0 8.5px rgb(43 21 48 / 0.28), 0 30px 50px -24px rgb(43 21 48 / 0.45);
  }
  .arch-photo { position: absolute; inset: 0; }
  .arch-photo[hidden] { display: none; }
  .arch :global(img), .arch :global(.cj-ph) { width: 100%; height: 100%; object-fit: cover; }
  .arch :global(img) { object-position: 30% 62%; }
  /* While the oven warms up, keep the arch empty instead of flashing the photo before the tray.
     If the script never runs at all (the arch never gets a state), the photo appears after 4 s. */
  :global(.cj-motion) .arch:not([data-scene='fallback']) .arch-photo { opacity: 0; }
  :global(.cj-motion) .arch:not([data-scene]) .arch-photo { animation: cj-reveal 0.4s ease-out 4s forwards; }
  :global(.cj-motion) .arch.is-slow:not([data-scene='fallback']) .arch-photo { opacity: 1; transition: opacity 0.4s ease-out; }
  .arch :global(canvas) { animation: cj-fade 0.7s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes cj-reveal { to { opacity: 1; } }
  @keyframes cj-fade { from { opacity: 0; } }

  .stamp { position: absolute; left: 0; top: 7%; width: 26%; max-width: 8.5rem; overflow: visible; rotate: -8deg; }
  .stamp-bg { fill: var(--jabuticaba); }
  .stamp-core { fill: var(--crosta); }
  .stamp-shine { fill: var(--creme); opacity: 0.9; }
  .stamp text { fill: var(--creme); font: 600 10.5px var(--sans); letter-spacing: 0.08em; text-transform: uppercase; }

  .tag {
    position: absolute; right: -0.25rem; bottom: -3.5%; rotate: -5deg;
    display: grid; gap: 0.1rem; padding: 0.6rem 1rem 0.65rem 1.85rem;
    background: var(--papel); color: var(--jabuticaba);
    border-radius: 0.4rem 1.1rem 1.1rem 0.4rem;
    box-shadow: 0 10px 24px -12px rgb(43 21 48 / 0.55), inset 0 0 0 1px rgb(43 21 48 / 0.14);
  }
  .tag-hole { position: absolute; left: 0.7rem; top: 50%; width: 0.5rem; height: 0.5rem; margin-top: -0.25rem; border-radius: 50%; background: var(--creme); box-shadow: inset 0 1px 2px rgb(43 21 48 / 0.45); }
  .tag-k { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--folha); }
  .tag-v { font-family: var(--display); font-size: 1.125rem; font-weight: 560; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
  .tag-v b { margin-left: 0.35rem; font-weight: 700; color: var(--crosta-texto); }
  .tag-v small { font: 600 0.65em var(--sans); margin-right: 0.15em; vertical-align: 0.25em; }

  /* On phones the tag hangs lower and smaller, below the front of the tray. */
  @media (max-width: 599px) {
    .tag { bottom: -9%; padding: 0.45rem 0.8rem 0.5rem 1.6rem; }
    .tag-hole { left: 0.6rem; }
    .tag-k { font-size: 0.6875rem; }
    .tag-v { font-size: 1rem; }
  }
  @media (min-width: 600px) {
    .hero-media { max-width: 36rem; }
  }

  @media (min-width: 960px) {
    .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 2.5rem; }
    .hero-title { font-size: min(calc(min(100vw - 2 * var(--gutter), var(--maxw)) * 0.57 / 6.6), 6rem); }
    .hero-media { max-width: 33rem; margin-right: 0; }
    /* The first screen holds still while the bake scrolls by, so the hero fills it below the banner and header. */
    :global(.cj-motion) .hero { min-height: calc(100svh - 7.3rem); display: flex; flex-direction: column; justify-content: center; }
  }

  /* Hidden until SplitText has cut the lines, so they never flash. A finite fallback reveals them if the script never runs. */
  :global(.cj-motion) .hero-title { visibility: hidden; animation: cj-show 0s linear 2.5s forwards; }
  @keyframes cj-show { to { visibility: visible; } }
</style>
