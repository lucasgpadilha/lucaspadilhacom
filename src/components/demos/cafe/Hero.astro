---
import Photo from './Photo.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="cj-wrap hero-grid">
    <div class="hero-copy">
      <p class="cj-eyebrow eyebrow"><span>Padaria artesanal e café</span><span class="sep" aria-hidden="true"></span><span>Barão Geraldo, Campinas</span></p>
      <h1 id="hero-title" class="hero-title">
        <span style="--i: 0">Pão com tempo,</span>
        <span style="--i: 1">café sem pressa</span>
        <span style="--i: 2">e <span class="accent">bolo de vó</span><span class="cj-dot title-dot" aria-hidden="true"></span><span class="cj-sr">.</span></span>
      </h1>
      <p class="hero-lead">
        Uma padaria de bairro com o forno aceso desde cedo. Pão de fermentação natural,
        pão de queijo com queijo de verdade, cafés especiais coados na hora e aqueles
        bolos que lembram a casa da avó.
      </p>
      <div class="hero-actions">
        <a class="cj-btn" href="/sites/#contato">
          Fazer encomenda
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a class="cj-textlink" href="#cardapio">Ver o cardápio</a>
      </div>
      <p class="cj-demo-note">Demonstração: no site real, este botão abre o WhatsApp da Casa Jabuticaba.</p>
    </div>

    <div class="hero-media">
      <div class="arch">
        <Photo slot="pao-de-queijo" sizes="(min-width: 960px) 52vw, (min-width: 600px) 75vw, 125vw" priority tone="crosta" />
      </div>
      <div class="coin">
        <Photo slot="cafe" sizes="(min-width: 960px) 27vw, 64vw" tone="jabuticaba" />
      </div>
      <svg class="stamp" viewBox="0 0 120 120" aria-hidden="true">
        <defs><path id="cj-ring" d="M60 60m-43 0a43 43 0 1 1 86 0a43 43 0 1 1-86 0" /></defs>
        <circle class="stamp-bg" cx="60" cy="60" r="59" />
        <g class="stamp-ring">
          <text><textPath href="#cj-ring" textLength="268" lengthAdjust="spacing">fermentação natural · pão de verdade ·</textPath></text>
        </g>
        <circle class="stamp-core" cx="60" cy="60" r="17" />
        <ellipse class="stamp-shine" cx="54" cy="53" rx="5" ry="3.4" transform="rotate(-35 54 53)" />
      </svg>
      <p class="tag">
        <span class="tag-hole" aria-hidden="true"></span>
        <span class="tag-k">Fornada das 10h30</span>
        <span class="tag-v">Pão de queijo <b><small>R$</small>7</b></span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(1.75rem, 4vw, 3.5rem) clamp(3.5rem, 8vw, 6.5rem); overflow-x: clip; }
  .hero-grid { display: grid; gap: clamp(2.75rem, 6vw, 4rem); align-items: center; }

  .eyebrow > span:not(.sep) { display: block; }
  .sep { display: none; width: 0.42em; height: 0.42em; margin: 0 0.6em 0.1em; border-radius: 50%; background: var(--crosta); vertical-align: middle; }
  @media (min-width: 600px) {
    .eyebrow > span:not(.sep) { display: inline; }
    .sep { display: inline-block; }
  }

  .hero-title {
    margin-top: 1rem;
    font-family: var(--display); font-weight: 620; color: var(--jabuticaba);
    font-size: min(calc((100vw - 2 * var(--gutter)) / 7.25), 6.25rem);
    line-height: 0.95; letter-spacing: -0.035em;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }
  .hero-title > span { display: block; }
  .accent { color: var(--crosta); font-weight: 700; }
  .title-dot { width: 0.2em; height: 0.2em; margin-left: 0.06em; vertical-align: baseline; }

  .hero-lead { max-width: 34rem; margin-top: 1.5rem; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); line-height: 1.55; color: var(--tinta); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin-top: 2rem; }
  .cj-demo-note { margin-top: 0.85rem; }

  /* Photo composition: the arch is the mouth of the oven, the coin is a jabuticaba. */
  .hero-media { position: relative; width: 100%; max-width: 34rem; margin-inline: auto; aspect-ratio: 1 / 1.08; }
  .arch, .coin { position: absolute; overflow: hidden; background: var(--miolo); }
  .arch {
    top: 0; right: 2%; width: 72%; aspect-ratio: 4 / 5;
    border-radius: 999px 999px 1.25rem 1.25rem; rotate: 2deg;
    box-shadow: 0 0 0 7px var(--creme), 0 0 0 8.5px rgb(43 21 48 / 0.28), 0 28px 50px -24px rgb(43 21 48 / 0.45);
  }
  .coin {
    left: 0; bottom: 3%; width: 42%; aspect-ratio: 1; border-radius: 50%; rotate: -8deg;
    box-shadow: 0 0 0 7px var(--creme), 0 20px 40px -18px rgb(43 21 48 / 0.5);
  }
  .arch :global(img), .coin :global(img), .arch :global(.cj-ph), .coin :global(.cj-ph) { width: 100%; height: 100%; object-fit: cover; }
  .arch :global(img) { object-position: 30% 62%; }
  .coin :global(img) { object-position: 58% 48%; transform: scale(1.12); }

  .stamp { position: absolute; left: 3%; top: 6%; width: 27%; max-width: 8.5rem; overflow: visible; }
  .stamp-bg { fill: var(--jabuticaba); }
  .stamp-core { fill: var(--crosta); }
  .stamp-shine { fill: var(--creme); opacity: 0.9; }
  .stamp text { fill: var(--creme); font: 600 10.5px var(--sans); letter-spacing: 0.08em; text-transform: uppercase; }
  .stamp-ring { transform-origin: 60px 60px; }

  .tag {
    position: absolute; right: 0; bottom: 7%; rotate: -5deg;
    display: grid; gap: 0.1rem; padding: 0.6rem 1rem 0.65rem 1.85rem;
    background: var(--papel); color: var(--jabuticaba);
    border-radius: 0.4rem 1.1rem 1.1rem 0.4rem;
    box-shadow: 0 10px 24px -12px rgb(43 21 48 / 0.55), inset 0 0 0 1px rgb(43 21 48 / 0.14);
  }
  .tag-hole { position: absolute; left: 0.7rem; top: 50%; width: 0.5rem; height: 0.5rem; margin-top: -0.25rem; border-radius: 50%; background: var(--creme); box-shadow: inset 0 1px 2px rgb(43 21 48 / 0.45); }
  .tag-k { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--folha); }
  .tag-v { font-family: var(--display); font-size: 1.125rem; font-weight: 560; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
  .tag-v b { margin-left: 0.35rem; font-weight: 700; color: var(--crosta-texto); }
  .tag-v small { font: 600 0.65em var(--sans); margin-right: 0.15em; vertical-align: 0.25em; }

  @media (min-width: 600px) {
    .hero-media { max-width: 36rem; }
  }

  @media (min-width: 960px) {
    .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 2rem; }
    .hero-title { font-size: min(calc(min(100vw - 2 * var(--gutter), var(--maxw)) * 0.57 / 6.6), 7.25rem); }
    .hero-media { max-width: none; margin-right: calc(var(--gutter) * -0.25); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-title > span { animation: cj-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(var(--i) * 90ms); }
    .arch { animation: cj-settle 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both; }
    .stamp-ring { animation: cj-spin 38s linear infinite; }
  }
  @keyframes cj-rise { from { opacity: 0; transform: translateY(0.25em); } }
  @keyframes cj-settle { from { opacity: 0; rotate: 6deg; translate: 0 1.5rem; } }
  @keyframes cj-spin { to { transform: rotate(360deg); } }
</style>
