---
import Cta from './Cta.astro';

/*
 * The top of the hero (rule and headline) hosts the ink scene (`data-ink-host`): the canvas
 * covers it edge to edge, and the lede, actions and facts sit below it on plain paper.
 * `.hero__stage` is an invisible square that places the bloom for each breakpoint; the shader
 * reads its box, and the static fallback (a frame of the same shader) sits inside it, so both
 * line up at every width. `data-ink-calm` on the headline caps how much ink may sit under it.
 */
// The fallback is the finished bloom rendered from the shader (stage units -1.7…1.7). The bloom
// leans toward a different origin above and below 1080px, so there is one frame for each.
const frame = (variant: 'topo' | 'lado', w: number) => `/sites/exemplos/advocacia/tinta-${variant}-${w}.webp`;
const frames = (variant: 'topo' | 'lado') => [640, 960, 1280].map((w) => `${frame(variant, w)} ${w}w`).join(', ');
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__ink" data-ink-host>
    <div class="lv-wrap hero__grid hero__grid--top">
      <div class="hero__stage" data-ink-stage aria-hidden="true">
        <picture>
          <source media="(min-width: 1080px)" srcset={frames('lado')} sizes="min(918px, 66vw)" />
          <img
            class="hero__fallback"
            data-fallback
            src={frame('topo', 960)}
            srcset={frames('topo')}
            sizes="(min-width: 720px) 680px, calc(136vw - 54px)"
            width="1280"
            height="1280"
            alt=""
            decoding="async"
            fetchpriority="low"
          />
        </picture>
      </div>
      <span class="lv-rule lv-rule--hero hero__rule" aria-hidden="true"></span>
      <h1 id="hero-title" class="hero__title" data-ink-calm="0.2">
        Seus direitos no trabalho e na família, explicados em <em>português claro</em>.
      </h1>
    </div>
  </div>
  <div class="lv-wrap hero__grid hero__grid--bottom">
    <div class="hero__body">
      <p class="hero__lede">
        Atendemos trabalhadores, empresas e famílias no Cambuí, em Campinas, e online em todo o Brasil.
        Antes de qualquer decisão, você entende o que a lei prevê, os caminhos possíveis e os riscos de cada um.
      </p>
      <div class="hero__actions">
        <Cta />
        <a class="hero__more" href="#areas">Ver as áreas de atuação</a>
      </div>
      <p class="hero__demo">Demonstração: no site real, este botão abre o WhatsApp do escritório.</p>
    </div>
    <dl class="hero__facts">
      <div><dt class="lv-label">Atendimento</dt><dd>Presencial no Cambuí ou por vídeo</dd></div>
      <div><dt class="lv-label">Horário</dt><dd>Segunda a sexta, das 9h às 18h</dd></div>
      <div><dt class="lv-label">Áreas</dt><dd>Trabalho, família e sucessões</dd></div>
    </dl>
  </div>
</section>

<style>
  /* No padding on the host: the runtime sizes the canvas from its content box. */
  .hero__ink { position: relative; isolation: isolate; overflow: clip; padding: 0; }
  /* The canvas the runtime appends sits under the headline. Its own 3D layer keeps Chromium's
     software compositor from presenting only part of it while the sticky banner overlaps it. */
  .hero__ink > :global(canvas) { z-index: 0; pointer-events: none; transform: translateZ(0.01px); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .hero__grid--top { position: relative; z-index: 1; padding-bottom: clamp(24px, 3vw, 40px); }
  .hero__grid--bottom { padding-bottom: clamp(48px, 5vw, 72px); }

  /*
   * Stage: where the bloom lives. Mobile and tablet: a square at the top right, above the
   * headline, so the ink opens into the margin and only its last veils reach the first line.
   */
  .hero__stage {
    position: relative; grid-row: 1; justify-self: end; pointer-events: none;
    width: min(80%, 440px); aspect-ratio: 1;
    margin: 48px -13% -38% 0;
    --ink-ox: -0.62; --ink-oy: 0.78;
  }
  .hero__fallback {
    position: absolute; left: -35%; top: -35%; width: 170%; max-width: none; height: auto;
    transition: opacity 0.6s var(--lv-ease);
  }
  .hero__fallback[hidden] { display: none; }

  .hero__rule { grid-row: 2; }
  .hero__title {
    grid-row: 3;
    margin-top: clamp(22px, 3.2vw, 44px);
    font-size: var(--lv-t-h1); font-weight: 340; line-height: 1.0; letter-spacing: -0.022em;
  }
  /* The italic file has no optical-size axis, so it is set lighter and tighter to sit with opsz 72. */
  .hero__title em { font-weight: 300; letter-spacing: -0.03em; padding-right: 0.04em; }
  .hero__lede { font-size: var(--lv-t-lede); line-height: 1.5; color: var(--lv-muted); max-width: 31em; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 28px; }
  .hero__more {
    display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--lv-sans); font-size: var(--lv-t-ui); font-weight: 600;
  }
  .hero__demo {
    margin-top: 14px; max-width: 30em;
    font-family: var(--lv-sans); font-size: 0.75rem; line-height: 1.5; color: var(--lv-muted);
  }
  .hero__facts { margin-top: 44px; display: grid; border-top: 1px solid var(--lv-rule-strong); }
  .hero__facts > div {
    display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 12px; align-items: baseline;
    padding-block: 11px; border-bottom: 1px solid var(--lv-rule);
  }
  .hero__facts dd { font-size: 0.9375rem; line-height: 1.45; }

  @media (min-width: 720px) {
    .hero__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; }
    .hero__stage { grid-column: 6 / -1; width: min(72%, 400px); margin-bottom: -34%; }
    .hero__rule, .hero__title { grid-column: 1 / -1; }
    .hero__body { grid-column: 1 / 8; }
    .hero__facts { grid-column: 8 / -1; align-self: end; margin-top: 0; }
  }

  /* Desktop: the bloom sits beside the headline and bleeds toward the edge. */
  @media (min-width: 1080px) {
    .hero__grid--top { padding-top: clamp(40px, 4vw, 64px); }
    /* Out of flow: its grid area (beside the headline) is only the containing block. */
    .hero__stage {
      position: absolute; grid-column: 8 / -1; grid-row: 2 / 3; margin: 0;
      right: calc(-0.4 * var(--lv-gutter)); top: 50%; translate: 0 -50%;
      width: min(96%, 540px);
      --ink-ox: -1.35; --ink-oy: 0.05;
    }
    .hero__rule { grid-column: 1 / 8; grid-row: 1; }
    .hero__title { grid-column: 1 / 9; grid-row: 2; }
    .hero__body { grid-column: 1 / 7; }
    .hero__facts {
      grid-column: 1 / -1; margin-top: clamp(48px, 5vw, 72px);
      grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 24px; border-top: 0;
    }
    .hero__facts > div { grid-template-columns: minmax(0, 1fr); gap: 6px; border-top: 1px solid var(--lv-rule-strong); border-bottom: 0; padding-block: 14px 0; }
  }

  /* Before the scene is live the fallback stays out of the way, so the bloom starts from paper. */
  :global([data-lv-motion]) .hero__ink:not([data-scene='fallback']) .hero__fallback { opacity: 0; }
  :global([data-lv-motion]) .hero__ink:not([data-scene]) .hero__fallback { animation: lv-fallback-in 0.6s var(--lv-ease) 2.5s both; }
  @keyframes lv-fallback-in { from { opacity: 0; } to { opacity: 1; } }
</style>
