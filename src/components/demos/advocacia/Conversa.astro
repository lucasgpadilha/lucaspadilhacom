---
import SecHead from './SecHead.astro';
import Cta from './Cta.astro';

/* Numbered like the incisos of a statute. */
const steps = [
  { n: 'I', t: 'Você nos conta o essencial', d: 'Pelo WhatsApp ou por e-mail, em poucas linhas. Respondemos em horário comercial para combinar o dia e o formato: no escritório ou por vídeo.' },
  { n: 'II', t: 'Reunimos os documentos', d: 'Enviamos antes uma lista do que ajuda na análise, como contrato, holerites, mensagens ou certidões. Não é preciso ter tudo em mãos.' },
  { n: 'III', t: 'Conversamos com calma', d: 'Cerca de uma hora para ouvir a história inteira e explicar o que a lei prevê, os caminhos possíveis, os prazos e os riscos de cada um.' },
  { n: 'IV', t: 'Você decide com tudo por escrito', d: 'Se fizer sentido seguir, enviamos uma proposta com o escopo do trabalho e os honorários. Nada começa antes da sua assinatura.' },
];
---
<section id="primeira-conversa" class="cv lv-dark" aria-labelledby="cv-title">
  <div class="lv-wrap">
    <div class="cv__head">
      <SecHead mark="§ 3º" id="cv-title" title="Como funciona a primeira&nbsp;conversa">
        <p>Uma consulta sem pressa, para entender o caso antes de qualquer compromisso.</p>
      </SecHead>
    </div>
    <ol class="cv__steps" role="list">
      {steps.map((s) => (
        <li class="step">
          <span class="step__n" aria-hidden="true">{s.n}</span>
          <h3 class="step__t">{s.t}</h3>
          <p class="step__d">{s.d}</p>
        </li>
      ))}
    </ol>
    <div class="cv__foot">
      <Cta tone="paper" />
      <p class="cv__fees">
        A consulta tem honorários, informados antes do agendamento e definidos conforme a tabela da OAB de São Paulo.
      </p>
    </div>
  </div>
</section>

<style>
  .cv { padding-block: clamp(64px, 9vw, 128px); }
  .cv :global(.sh__title) { color: var(--lv-on-ink); }
  .cv__steps { margin-top: clamp(40px, 5vw, 72px); display: grid; }
  .step { padding-block: 26px 30px; border-top: 1px solid var(--lv-brass); }
  /* Brass on ink is 4.67:1, so it also holds at this size. */
  .step__n {
    display: block; font-size: 2.75rem; line-height: 1; font-weight: 300; color: var(--lv-brass);
    letter-spacing: 0.04em;
  }
  .step__t { margin-top: 18px; font-size: var(--lv-t-h3); font-weight: 400; line-height: 1.15; color: var(--lv-on-ink); }
  .step__d { margin-top: 12px; color: var(--lv-on-ink-muted); max-width: 30em; }
  .cv__foot {
    margin-top: clamp(36px, 5vw, 64px); padding-top: 32px; border-top: 1px solid rgba(244, 239, 228, 0.18);
    display: grid; gap: 20px; align-items: center;
  }
  .cv__fees { font-family: var(--lv-sans); font-size: 0.875rem; line-height: 1.6; color: var(--lv-on-ink-muted); max-width: 34em; }

  @media (min-width: 720px) {
    .cv__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; }
    .cv__foot { grid-template-columns: auto minmax(0, 1fr); column-gap: 40px; }
  }
  @media (min-width: 1080px) {
    .cv__head { max-width: 62%; }
    .cv__steps { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 0; }
    .step { padding-inline: 0 28px; }
    .step + .step { padding-left: 28px; border-left: 1px solid rgba(244, 239, 228, 0.14); }
    .step__n { font-size: 3.5rem; }
  }
</style>
