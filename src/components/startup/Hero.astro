---
import Text from './Text.astro';
import { copy } from '../../data/startup-content';
---
<section class="studio-hero" aria-labelledby="studio-title">
  <div class="hero-wordmark"><h1 id="studio-title" translate="no">Nexora<span>Games</span></h1></div>
  <div class="hero-composition">
    <div class="hero-copy">
      <p class="studio-intro"><Text text={copy.independent} /></p>
      <h2 class="hero-statement">{copy.heroLines.map(line => <span><Text text={line} /></span>)}</h2>
      <p class="hero-description"><Text text={copy.intro} /></p>
      <div class="hero-actions">
        <a class="button button-yellow" href="#comboio"><Text text={copy.explore} /><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5h10v10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></a>
        <a class="text-link" href="mailto:ceo@lucaspadilha.com"><Text text={copy.contactAction} /></a>
      </div>
    </div>
    <figure class="hero-game">
      <img src="/startup/hero-720.webp" srcset="/startup/hero-360.webp 360w, /startup/hero-720.webp 720w, /startup/hero-1080.webp 1080w" sizes="(max-width: 640px) calc(100vw - 48px), (max-width: 1000px) 43vw, 600px" width="1080" height="1920" alt={copy.heroAlt.en} data-alt-en={copy.heroAlt.en} data-alt-pt={copy.heroAlt.pt} fetchpriority="high" />
      <figcaption><span translate="no">Comboio Bruto</span><span><Text text={{ en: 'In development', pt: 'Em desenvolvimento' }} /></span></figcaption>
    </figure>
    <span class="hero-side-note" aria-hidden="true"><Text text={{ en: 'Made to be played together.', pt: 'Feito para jogar junto.' }} /></span>
  </div>
</section>
