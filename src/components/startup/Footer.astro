---
import Text from './Text.astro';
import Mark from './Mark.astro';
import { copy } from '../../data/startup-content';
---
<footer class="studio-footer">
  <div class="footer-row"><a href="#top" class="brand" aria-label="Nexora Games — back to top" data-label-en="Nexora Games — back to top" data-label-pt="Nexora Games — voltar ao topo"><Mark /><span translate="no">Nexora Games</span></a><p>© {new Date().getFullYear()} Nexora Games</p><span><Text text={{ en: 'Independent. Brazil.', pt: 'Independente. Brasil.' }} /></span></div>
  <nav class="footer-links" aria-label="Contact and portfolio" data-label-en="Contact and portfolio" data-label-pt="Contato e portfólio"><a href="mailto:ceo@lucaspadilha.com">ceo@lucaspadilha.com</a><a href="/"><Text text={copy.portfolio} /></a></nav>
  <details class="media-credits"><summary><Text text={copy.credits} /></summary><div><p><Text text={copy.creditIntro} /></p><ul><li><a href="https://sketchfab.com/3d-models/low-poly-gas-station-game-ready-3d-environment-c6089772504441e0bc68134dcc726655">Low-Poly Gas Station — Nali (@NaliMain)</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</li><li><a href="https://sketchfab.com/3d-models/landscape-forest-mountains-94809d21d7aa4cfe9b658a111b35a42c">Landscape forest & mountains — dasy444</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</li><li><a href="https://kenney.nl/assets">Kenney</a> & <a href="https://3dassets.dev/">3DAssets.dev</a>, CC0.</li><li><a href="https://www.cgtrader.com/free-3d-models/vehicle/truck/low-poly-truck-3d-model-pack">Low Poly Truck 3D Model Pack — ankitrajput8161</a>.</li></ul><p><Text text={copy.creditChanges} /> <a href="/startup/fonts/OFL.txt"><Text text={{ en: 'Font license', pt: 'Licença da fonte' }} /></a></p></div></details>
</footer>
