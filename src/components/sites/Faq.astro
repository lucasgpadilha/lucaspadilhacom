---
import { faq } from '../../data/sites';
---
<section id="duvidas" class="section" aria-labelledby="duvidas-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="label">05 — Dúvidas</p>
      <h2 id="duvidas-title">Perguntas que todo mundo faz</h2>
    </header>
    <div class="list" data-reveal>
      {faq.map((item) => (
        <details>
          <summary><span>{item.q}</span><span class="plus" aria-hidden="true"></span></summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .list { border-top: 2px solid var(--ink); }
  @media (min-width: 960px) { .list { margin-left: calc(25% + 0.25rem); } }
  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    min-height: 64px; padding: 1rem 0; font-size: var(--step-1); font-weight: 600; line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  .plus { position: relative; flex: none; width: 18px; height: 18px; }
  .plus::before, .plus::after { content: ''; position: absolute; inset: 8px 0 auto; height: 2px; background: currentColor; transition: transform 0.25s var(--ease-out); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0deg); }
  details p { padding: 0 0 1.5rem; color: var(--ink-2); max-width: 60ch; }
</style>
