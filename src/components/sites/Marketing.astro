---
import Arrow from '../site/Arrow.astro';
import { contactChannel, contactHref, marketing } from '../../data/sites';
---
<section id="marketing" class="section marketing" aria-labelledby="marketing-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="marketing-title">{marketing.title}</h2>
      <p class="lede">{marketing.lede}</p>
    </header>
    <ul class="items" role="list">
      {marketing.items.map((item) => (
        <li data-reveal>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
    <p class="foot" data-reveal>
      <span>{marketing.note}</span>
      <a class="btn btn--ghost" href={contactHref('Olá, Lucas! Quero saber mais sobre marketing digital para o meu negócio.\n\nNome do negócio:\nCidade:\nInstagram (link):\n')} data-contact={contactChannel}>Quero conversar <Arrow /></a>
    </p>
  </div>
</section>

<style>
  .items { display: grid; grid-template-columns: minmax(0, 1fr); border-top: 2px solid var(--ink); }
  .items li { display: grid; gap: 0.4rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  h3 { font-size: var(--step-2); }
  p { color: var(--ink-2); max-width: 44ch; }
  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2rem; }
  .foot span { color: var(--ink-2); }
  @media (min-width: 860px) { .items { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3rem; } }
</style>
