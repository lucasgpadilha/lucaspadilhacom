---
import { howIWork } from '../../data/home';
import { t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section id="how" class="zone-night section how" aria-labelledby="how-title" data-theme-zone="night">
  <div class="wrap">
    <header class="section-head">
      <h2 id="how-title">{t(howIWork.title, locale)}</h2>
    </header>
    <ol class="practices" role="list">
      {howIWork.items.map((item) => (
        <li data-reveal>
          <h3>{t(item.title, locale)}</h3>
          <p>{t(item.body, locale)}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how { border-top-color: var(--line); }
  .practices { display: grid; gap: 2.5rem; }
  h3 { font-size: var(--step-2); }
  p { color: var(--ink-2); margin-top: 0.75rem; max-width: 40ch; font-size: var(--step-1); line-height: 1.45; }
  @media (min-width: 900px) { .practices { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem; } }
</style>
