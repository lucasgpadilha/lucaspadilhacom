---
import Arrow from './Arrow.astro';
import type { Project } from '../../data/home';
import { t, type Locale } from '../../lib/locale';

interface Props { project: Project; locale: Locale }
const { project: p, locale } = Astro.props;
const external = p.link?.href.startsWith('http');
const stats = p.stats ? t(p.stats, locale) : null;
---
<article class={`card card--${p.layout}`} aria-labelledby={`p-${p.slug}`} data-reveal>
  {p.image && (
    <img
      class="shot"
      src={p.image.src}
      srcset={p.image.srcset}
      sizes="(min-width: 1100px) 30vw, (min-width: 720px) 45vw, 92vw"
      width={p.image.width}
      height={p.image.height}
      alt={t(p.image.alt, locale)}
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="body">
    <p class="label kind">{t(p.kind, locale)}</p>
    <h3 id={`p-${p.slug}`}>{t(p.title, locale)}</h3>
    <p class="pitch">{t(p.pitch, locale)}</p>
    {stats && (
      <dl class="stats">
        {stats.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
      </dl>
    )}
    <ul class="evidence" role="list">
      {t(p.evidence, locale).map((item) => <li>{item}</li>)}
    </ul>
    <ul class="chips" role="list" aria-label="Stack">
      {p.stack.map((item) => <li>{item}</li>)}
    </ul>
    <p class="foot">
      <span class="role">{t(p.role, locale)}</span>
      {p.link
        ? <a href={p.link.href}>{t(p.link.label, locale)}<Arrow dir={external ? 'up-right' : 'right'} size={14} /></a>
        : p.note && <span class="note">{t(p.note, locale)}</span>}
    </p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .body { display: flex; flex-direction: column; gap: 1rem; padding: clamp(1.25rem, 1rem + 1vw, 2rem); flex: 1; }
  h3 { font-size: var(--step-2); }
  .pitch { color: var(--ink-2); max-width: 62ch; }
  .shot { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 60%; background: var(--line); }
  .evidence { display: grid; gap: 0.45rem; font-size: var(--step--1); }
  .evidence li { display: grid; grid-template-columns: 0.9rem 1fr; gap: 0.5rem; }
  .evidence li::before { content: '—'; color: var(--ink-2); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .chips li {
    font-family: var(--font-mono); font-size: 0.6875rem; line-height: 1;
    padding: 0.4rem 0.5rem; border: 1px solid var(--line-strong); border-radius: 2px;
  }
  .foot {
    margin-top: auto; padding-top: 1rem; border-top: 1px dashed var(--line-strong);
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem 1rem;
    font-size: var(--step--1);
  }
  .role { color: var(--ink-2); }
  .foot a { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; font-weight: 600; }
  .note { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--ink-2); }

  .card--feature { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .card--feature .pitch, .card--feature .role, .card--feature .note,
  .card--feature .evidence li::before, .card--feature .kind { color: color-mix(in srgb, var(--paper) 72%, transparent); }
  .card--feature .chips li { border-color: color-mix(in srgb, var(--paper) 30%, transparent); }
  .card--feature .foot { border-top-color: color-mix(in srgb, var(--paper) 30%, transparent); }
  .card--feature h3 { font-size: var(--step-3); max-width: 16ch; }
  .card--feature .pitch { font-size: var(--step-1); line-height: 1.45; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; padding-block: 0.5rem; }
  .stats div { display: flex; flex-direction: column-reverse; gap: 0.25rem; border-left: 2px solid var(--signal); padding-left: 0.75rem; }
  .stats dd { font-size: var(--step-3); font-weight: 680; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .stats dt { font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em; color: color-mix(in srgb, var(--paper) 72%, transparent); }
  @media (max-width: 480px) { .stats { grid-template-columns: 1fr; } }

  @media (min-width: 720px) {
    .card--feature { grid-column: 1 / -1; }
    .card--tall { grid-row: span 2; }
    .card--tall .shot { aspect-ratio: 4 / 5; }
  }
  @media (min-width: 1100px) {
    .card--feature { grid-column: span 8; }
    .card--tall { grid-column: span 4; }
    .card--std { grid-column: span 4; }
    .card--half { grid-column: span 6; }
    .card--tall .shot { aspect-ratio: auto; flex: 1 1 0; min-height: 300px; height: 0; }
    .card--tall .body { flex: none; }
  }
</style>
