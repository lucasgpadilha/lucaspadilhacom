---
import { feats } from '../../data/home';
import { t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section id="feats" class="zone-night section feats" aria-labelledby="feats-title" data-theme-zone="night">
  <div class="wrap">
    <header class="section-head">
      <h2 id="feats-title">{t(feats.title, locale)}</h2>
    </header>
    <ul class="list" role="list">
      {feats.items.map((item) => (
        <li data-reveal>
          <h3>{t(item.title, locale)}</h3>
          <p>{t(item.body, locale)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .feats { border-top: 0; }
  .list { display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1px solid var(--line-strong); }
  .list li { display: grid; gap: 0.4rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line); }
  h3 { font-size: var(--step-1); font-weight: 620; letter-spacing: -0.015em; line-height: 1.2; }
  p { color: var(--ink-2); font-size: var(--step--1); max-width: 52ch; }
  @media (min-width: 860px) {
    .list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3rem; }
  }
  @media (min-width: 1200px) {
    .list li { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); column-gap: 1.5rem; align-items: baseline; }
  }
</style>
