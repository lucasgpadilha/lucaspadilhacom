---
import { how, operations as ops } from '../../data/operations';
import { t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;
const pt = locale === 'pt';
// "[1.100+] hosts…" → the bracketed number is set apart.
const parts = (text: string) => text.split(/\[([^\]]+)\]/);
---
<section id="operations" class="zone-night operations" aria-labelledby="operations-title">
  <div class="wrap">
    <header class="head">
      <h2 id="operations-title">{t(ops.title, locale)}</h2>
      <p class="lede">{t(ops.lede, locale)}</p>
    </header>
    <div class="grid">
      {ops.items.map((item) => (
        <article id={item.id} class="item" aria-labelledby={`${item.id}-title`}>
          <h3 id={`${item.id}-title`}>{t(item.title, locale)}</h3>
          <p class="pain">“{t(item.pain, locale)}”</p>
          <p class="body">{parts(t(item.body, locale)).map((part, i) => (i % 2 ? <b>{part}</b> : part))}</p>
          <p class="tools"><span class="visually-hidden">{pt ? 'Ferramentas' : 'Tools'}: </span>{item.tools.join(' · ')}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="how" class="zone-night how" aria-labelledby="how-title">
  <div class="wrap row">
    <h2 id="how-title">{t(how.title, locale)}</h2>
    <ol role="list">
      {how.steps.map((step) => (
        <li><b>{t(step.title, locale)}</b><span>{t(step.body, locale)}</span></li>
      ))}
    </ol>
  </div>
</section>

<style>
  .operations { padding-block: clamp(3.5rem, 2.5rem + 3vw, 6rem); border-top: 1px solid var(--line); }
  .head { display: grid; gap: 0.9rem; margin-bottom: 2rem; }
  h2 { font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem); letter-spacing: -0.03em; }
  .head .lede { font-size: var(--step-0); color: var(--ink-2); max-width: 52ch; }
  @media (min-width: 1080px) {
    .head { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: 3.5rem; align-items: end; }
  }
  .grid { display: grid; gap: 2rem 3rem; }
  .item { display: grid; gap: 0.6rem; align-content: start; padding-top: 1.1rem; border-top: 1px solid var(--line-strong); }
  h3 { font-size: var(--step-1); letter-spacing: -0.02em; }
  .pain { color: var(--signal); font-weight: 540; line-height: 1.4; }
  .body { font-size: 0.9375rem; color: var(--ink-2); line-height: 1.55; }
  .body b { font-family: var(--font-mono); font-weight: 600; color: var(--signal); font-size: 0.875rem; }
  .tools { font-size: 0.8125rem; color: var(--ink-2); padding-top: 0.6rem; border-top: 1px solid var(--line); }
  @media (min-width: 900px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .how { padding-block: 0 clamp(3.5rem, 2.5rem + 3vw, 6rem); }
  .row { display: grid; gap: 1.25rem; }
  .how h2 { font-size: var(--step-2); }
  .how ol { display: grid; gap: 1.25rem; margin: 0; padding: 0; }
  .how li { display: grid; gap: 0.3rem; font-size: 0.9375rem; color: var(--ink-2); line-height: 1.5; }
  .how b { color: var(--ink); font-weight: 620; }
  @media (min-width: 900px) {
    .row { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); column-gap: 3.5rem; align-items: start; }
    .how ol { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 2rem; }
  }
</style>
