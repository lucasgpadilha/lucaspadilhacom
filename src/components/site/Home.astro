---
import Base from '../../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import DeployScene from './DeployScene.astro';
import Arrow from './Arrow.astro';
import Migration from './Migration.astro';
import Feats from './Feats.astro';
import HowIWork from './HowIWork.astro';
import Stack from './Stack.astro';
import SitesMarketing from './SitesMarketing.astro';
import SideProjects from './SideProjects.astro';
import Contact from './Contact.astro';
import { email, hero, meta, nav } from '../../data/home';
import { homePath, t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;
const path = homePath(locale);
const pt = locale === 'pt';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lucas Padilha',
  url: 'https://lucaspadilha.com/',
  email,
  jobTitle: pt ? 'Engenheiro DevOps e de cloud' : 'DevOps and cloud engineer',
  address: { '@type': 'PostalAddress', addressLocality: 'Ponta Grossa', addressRegion: 'PR', addressCountry: 'BR' },
  knowsAbout: ['Kubernetes', 'OCI', 'Terraform', 'Argo CD', 'Ansible', 'FinOps', 'Web development', 'Digital marketing'],
  sameAs: ['https://github.com/lucasgpadilha', 'https://www.linkedin.com/in/lucasgpadilha/'],
};
---
<Base
  title={t(meta.title, locale)}
  description={t(meta.description, locale)}
  path={path}
  locale={locale}
  alternates={{ en: '/', pt: '/pt/' }}
  ogImage={pt ? '/og/home-pt.jpg' : '/og/home-en.jpg'}
  jsonLd={jsonLd}
  langScript={pt ? 'pt' : 'root'}
  theme="night"
>
  <Header
    locale={locale}
    home={path}
    links={t(nav, locale)}
    lang={{ en: '/', pt: '/pt/' }}
    cta={{ href: '/sites/', label: t(hero.secondary, locale) }}
  />
  <main id="main" tabindex="-1">
    <section class="hero zone-night" aria-labelledby="hero-title">
      <div class="wrap grid">
        <h1 id="hero-title">
          {t(hero.lines, locale).map((line) => <span class="line">{line}</span>)}
        </h1>
        <div class="scene">
          <DeployScene locale={locale} />
        </div>
        <div class="copy">
          <p class="lede">{t(hero.lede, locale)}</p>
          <p class="proof">{t(hero.proof, locale)}</p>
          <div class="actions">
            <a class="btn btn--light" href="#kubernetes">{t(hero.primary, locale)} <Arrow dir="down" /></a>
            <a class="sites-link" href="/sites/" hreflang="pt-BR">{t(hero.sites, locale)} <Arrow /></a>
          </div>
        </div>
      </div>
    </section>
    <Migration locale={locale} />
    <Feats locale={locale} />
    <HowIWork locale={locale} />
    <Stack locale={locale} />
    <SitesMarketing locale={locale} />
    <SideProjects locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>

<style>
  .hero { padding-block: clamp(1.75rem, 1rem + 2.5vw, 3rem) clamp(2.5rem, 1.5rem + 3vw, 4rem); overflow: hidden; }
  .grid { display: grid; gap: 1.5rem; grid-template-areas: 'title' 'scene' 'copy'; }
  h1 { grid-area: title; font-size: clamp(2.25rem, 1.5rem + 3.2vw, 4.25rem); font-weight: 680; letter-spacing: -0.035em; line-height: 0.98; }
  h1 .line { display: block; }
  h1 .line + .line { color: var(--signal); }
  .scene { grid-area: scene; }
  .copy { grid-area: copy; display: grid; gap: 1rem; align-content: start; }
  .lede { font-size: var(--step-1); max-width: 42ch; color: var(--ink); }
  .proof { font-size: var(--step--1); color: var(--ink-2); max-width: 48ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; margin-top: 0.5rem; }
  .btn--light { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .sites-link { display: inline-flex; align-items: center; gap: 0.45em; min-height: 44px; font-size: 0.9375rem; color: var(--ink-2); }
  .sites-link:hover { color: var(--ink); }
  @media (min-width: 1080px) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: 'title scene' 'copy scene';
      column-gap: 3rem; row-gap: 1.75rem;
      min-height: calc(100svh - 64px - 6rem);
      align-content: center;
    }
    h1 { align-self: end; }
    .scene { align-self: center; }
  }
</style>
