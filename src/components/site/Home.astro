---
import Base from '../../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Receipt from './Receipt.astro';
import Arrow from './Arrow.astro';
import Migration from './Migration.astro';
import Feats from './Feats.astro';
import HowIWork from './HowIWork.astro';
import Stack from './Stack.astro';
import SitesMarketing from './SitesMarketing.astro';
import SideProjects from './SideProjects.astro';
import Contact from './Contact.astro';
import { email, hero, meta, nav } from '../../data/home';
import { homePath, t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;
const path = homePath(locale);
const pt = locale === 'pt';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lucas Padilha',
  url: 'https://lucaspadilha.com/',
  email,
  jobTitle: pt ? 'Engenheiro DevOps e de cloud' : 'DevOps and cloud engineer',
  address: { '@type': 'PostalAddress', addressLocality: 'Ponta Grossa', addressRegion: 'PR', addressCountry: 'BR' },
  knowsAbout: ['Kubernetes', 'OCI', 'Terraform', 'Argo CD', 'Ansible', 'FinOps', 'Web development', 'Digital marketing'],
  sameAs: ['https://github.com/lucasgpadilha', 'https://www.linkedin.com/in/lucasgpadilha/'],
};
---
<Base
  title={t(meta.title, locale)}
  description={t(meta.description, locale)}
  path={path}
  locale={locale}
  alternates={{ en: '/', pt: '/pt/' }}
  ogImage={pt ? '/og/home-pt.jpg' : '/og/home-en.jpg'}
  jsonLd={jsonLd}
  langScript={pt ? 'pt' : 'root'}
>
  <Header
    locale={locale}
    home={path}
    links={t(nav, locale)}
    lang={{ en: '/', pt: '/pt/' }}
    cta={{ href: '/sites/', label: t(hero.secondary, locale) }}
  />
  <main id="main" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap grid">
        <div class="copy">
          <h1 id="hero-title" data-split>
            {t(hero.lines, locale).map((line) => <span class="line">{line}</span>)}
          </h1>
          <p class="lede">{t(hero.lede, locale)}</p>
          <div class="actions">
            <a class="btn" href="#infra">{t(hero.primary, locale)} <Arrow dir="down" /></a>
            <a class="btn btn--ghost" href="/sites/" hreflang="pt-BR">{t(hero.secondary, locale)} <Arrow /></a>
          </div>
        </div>
        <div class="receipt-col">
          <Receipt locale={locale} variant="home" />
        </div>
      </div>
    </section>
    <Migration locale={locale} />
    <Feats locale={locale} />
    <HowIWork locale={locale} />
    <Stack locale={locale} />
    <SitesMarketing locale={locale} />
    <SideProjects locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>

<style>
  .hero { padding-block: clamp(3rem, 2rem + 6vw, 8rem) clamp(4rem, 2rem + 6vw, 8rem); }
  .grid { display: grid; gap: clamp(3rem, 2rem + 4vw, 5rem); align-items: end; }
  .copy { display: grid; gap: 1.75rem; }
  h1 { font-size: clamp(2.5rem, 1.2rem + 5.4vw, 6rem); font-weight: 690; letter-spacing: -0.04em; line-height: 0.95; max-width: 14ch; }
  h1 .line { display: block; }
  h1 .line + .line { color: var(--ink-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .receipt-col { max-width: 380px; width: 100%; justify-self: center; }
  @media (min-width: 1080px) {
    .grid { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); }
    .receipt-col { justify-self: end; }
  }
  @media (max-width: 420px) { .actions .btn { flex: 1 1 100%; } }
</style>
