---
import Base from '../../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Scenario from './Scenario.astro';
import Cloud from './Cloud.astro';
import Kubernetes from './Kubernetes.astro';
import Delivery from './Delivery.astro';
import FinOps from './FinOps.astro';
import Operations from './Operations.astro';
import Websites from './Websites.astro';
import Contact from './Contact.astro';
import { email, hero, meta, nav } from '../../data/home';
import { homePath, t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;
const path = homePath(locale);
const pt = locale === 'pt';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lucas Padilha',
  url: 'https://lucaspadilha.com/',
  email,
  jobTitle: pt ? 'Engenheiro DevOps e de cloud' : 'DevOps and cloud engineer',
  address: { '@type': 'PostalAddress', addressLocality: 'Ponta Grossa', addressRegion: 'PR', addressCountry: 'BR' },
  knowsAbout: ['Kubernetes', 'OCI', 'Terraform', 'Argo CD', 'Ansible', 'FinOps', 'Web development', 'Digital marketing'],
  sameAs: ['https://github.com/lucasgpadilha', 'https://www.linkedin.com/in/lucasgpadilha/'],
};
---
<Base
  title={t(meta.title, locale)}
  description={t(meta.description, locale)}
  path={path}
  locale={locale}
  alternates={{ en: '/', pt: '/pt/' }}
  ogImage={pt ? '/og/home-pt.jpg' : '/og/home-en.jpg'}
  jsonLd={jsonLd}
  langScript={pt ? 'pt' : 'root'}
  theme="night"
>
  <Header
    locale={locale}
    home={path}
    links={t(nav, locale)}
    lang={{ en: '/', pt: '/pt/' }}
    cta={{ href: '/sites/', label: t(hero.secondary, locale) }}
  />
  <main id="main" tabindex="-1">
    <section class="hero zone-night" aria-labelledby="hero-title">
      <Scenario locale={locale} />
    </section>
    <Cloud locale={locale} />
    {/* PLATFORM */}
    <Kubernetes locale={locale} />
    <Delivery locale={locale} />
    <FinOps locale={locale} />
    <Operations locale={locale} />
    <div class="zone-paper" data-zone="paper">
      <Websites locale={locale} />
      <Contact locale={locale} />
    </div>
  </main>
  <Footer locale={locale} />
</Base>

<script>
  // The header follows the zone under it: night until the paper half reaches its bottom edge.
  const paper = document.querySelector('[data-zone="paper"]');
  if (paper) {
    const root = document.documentElement;
    let queued = false;
    const sync = () => {
      queued = false;
      const theme = paper.getBoundingClientRect().top <= 64 ? 'paper' : 'night';
      if (root.dataset.theme !== theme) root.dataset.theme = theme;
    };
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(sync); } };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    sync();
  }
</script>

<style>
  /* clip, not hidden: hidden would make the hero a scroll box and break the sticky map on phones. */
  .hero { padding-block: clamp(1.5rem, 1rem + 2vw, 2.75rem) clamp(2rem, 1.5rem + 2vw, 3rem); overflow-x: clip; }
</style>
