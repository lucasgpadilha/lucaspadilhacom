---
// The FinOps drawing: 128 cubes of 0.1 core are the CPU the pods requested; the few
// that light up are what they used at p95; rightsizing then lays the rest flat. Beside
// it, the other findings and results as bars on one 0–100 scale. Geometry is built at
// build time; the run is CSS and starts when the figure scrolls into view.
import { Iso, percent, type P3 } from '../../lib/iso';
import { finops } from '../../data/finops';
import { t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;

const iso = new Iso(22);

// 8 rows of 16 along y. Row 0 is at the back; row 7 runs down the front-right edge.
const ROWS = 8;
const COLS = 16;
const SIZE = 0.7; // cube footprint, in cells
const H = 0.6; // cube height
const off = (1 - SIZE) / 2;
// 0.86 core = 8 full cubes and 60% of a ninth, filled from the front corner backwards.
const FULL = 8;
const PART = 0.6;
const front = ROWS - 1;
const firstUsed = COLS - 1 - FULL; // the partial cube
const isUsed = (i: number, j: number) => i === front && j >= firstUsed;

const cube = (i: number, j: number, z: number, h: number) => iso.box(i + off, j + off, z, SIZE, SIZE, h);

const plate = iso.box(-0.45, -0.45, -0.24, ROWS + 0.9, COLS + 0.9, 0.24);

// Each row is one group: all its +y faces, all its +x faces, then all its tops. Rows are
// drawn back to front, which is a correct painter's order for equal cubes on a plane.
const rows = Array.from({ length: ROWS }, (_, i) => {
  const cubes = Array.from({ length: COLS }, (_, j) => j).filter((j) => !isUsed(i, j)).map((j) => cube(i, j, 0, H));
  return {
    l: cubes.map((c) => c.left).join(''),
    r: cubes.map((c) => c.right).join(''),
    t: cubes.map((c) => c.top).join(''),
  };
});

// The used cubes sit at the front, so they are drawn last. `k` is the lighting order,
// from the front corner back; the partial cube is the last to light.
const used = Array.from({ length: FULL + 1 }, (_, n) => firstUsed + n).map((j) => {
  const k = COLS - 1 - j;
  const partial = j === firstUsed;
  return {
    k,
    body: cube(front, j, 0, partial ? H * PART : H),
    cap: partial ? cube(front, j, H * PART, H * (1 - PART)) : null,
  };
});

// A little room above the plate for the two top labels.
const fit = iso.viewBox(14);
const roomTop = 0.6 * iso.unit;
const box = { x: fit.x, y: +(fit.y - roomTop).toFixed(2), w: fit.w, h: +(fit.h + roomTop).toFixed(2) };
const viewBox = `${box.x} ${box.y} ${box.w} ${box.h}`;
const floor = iso.grid(-8, ROWS + 8, -6, COLS + 6, 1, -0.24);
const drop = +(H * iso.unit).toFixed(2); // how far a lid falls to lie on the plate

// The run, in seconds: rows land back to front, the used cubes light from the front
// corner, then rightsizing lays the rest flat, back to front, towards the use.
const T = {
  row: (i: number) => 0.1 + i * 0.11,
  heat: (k: number) => 1.45 + k * 0.07,
  flat: (i: number) => 2.85 + i * 0.07,
};
const s = (n: number) => `${n.toFixed(2)}s`;

// Label anchors in world units; `phone` moves a label where a narrow stage has room
// (the used label drops under the plate's front corner).
const pins: Record<string, { at: P3; phone?: P3; time: number }> = {
  requested: { at: [-0.9, 3.6, 0], time: 1.0 },
  used: { at: [ROWS + 0.9, COLS - 4.4, 0], phone: [ROWS + 0.45, COLS + 0.45, -0.24], time: 2.15 },
  rightsizing: { at: [1.8, -0.8, 0], time: 3.55 },
};
const place = (key: string) => {
  const { at, phone, time } = pins[key];
  const a = percent(iso, box, at);
  const m = phone ? percent(iso, box, phone) : a;
  return `--x:${a.left};--y:${a.top};--mx:${m.left};--my:${m.top};--at:${s(time)}`;
};
const g = finops.grid;
const r = finops.results;
---
<figure class="finops" data-finops>
  <div class="stage" data-play style={`aspect-ratio:${box.w} / ${box.h};--drop:${drop}px`}>
    <svg viewBox={viewBox} aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="finops-fade" cx="45%" cy="55%" r="55%">
          <stop offset="0.4" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
        </radialGradient>
        <mask id="finops-mask"><rect x={box.x} y={box.y} width={box.w} height={box.h} fill="url(#finops-fade)" /></mask>
      </defs>
      <g class="base">
        <path class="floor" d={floor} mask="url(#finops-mask)" />
        <path class="l" d={plate.left} /><path class="r" d={plate.right} /><path class="t plate" d={plate.top} />
      </g>
      {rows.map((row, i) => (
        <g class="row" style={`--at:${s(T.row(i))};--flat:${s(T.flat(i))}`}>
          <path class="l side" d={row.l} /><path class="r side" d={row.r} /><path class="t lid" d={row.t} />
        </g>
      ))}
      <g class="used" style={`--at:${s(T.row(front))};--flat:${s(T.flat(front))}`}>
        {used.map((cell) => (
          <g class="cell" style={`--heat:${s(T.heat(cell.k))}`}>
            <path class="l" d={cell.body.left} /><path class="r" d={cell.body.right} /><path class="t" d={cell.body.top} />
            {cell.cap && (
              <g class="cap"><path class="l" d={cell.cap.left} /><path class="r" d={cell.cap.right} /><path class="t" d={cell.cap.top} /></g>
            )}
          </g>
        ))}
      </g>
    </svg>

    <ul class="pins" role="list" aria-hidden="true">
      <li class="pin requested" style={place('requested')}>
        <span class="line"><b>{t(g.requested.value, locale)}</b> {t(g.requested.text, locale)}</span>
        <span class="note">{t(g.unit, locale)}</span>
      </li>
      <li class="pin used" style={place('used')}>
        <span class="line"><i class="cell-key used"></i><b>{t(g.used.value, locale)}</b> {t(g.used.text, locale)}</span>
        <span class="note ratio"><b>{t(g.ratio.value, locale)}</b> {t(g.ratio.text, locale)}</span>
      </li>
      <li class="pin rightsizing" style={place('rightsizing')}>
        <span class="line"><i class="cell-key"></i>{t(g.rightsizing, locale)}</span>
      </li>
    </ul>
  </div>

  <div class="ledger" data-play>
    <div class="group">
      <h3>
        {t(finops.findings.title, locale)} <span class="scale">{t(finops.findings.scale, locale)}</span>
      </h3>
      <ul role="list">
        {finops.findings.items.map((item, n) => (
          <li class="item" style={`--at:${s(0.15 + n * 0.12)}`}>
            <span class="name">{t(item.name, locale)}</span>
            <span class="val">{t(item.value, locale)}</span>
            <span class="track" aria-hidden="true"><span class="fill share" style={`width:${item.share}%`}></span></span>
          </li>
        ))}
      </ul>
    </div>
    <div class="group">
      <h3>
        {t(r.title, locale)} <span class="scale">{t(r.scale, locale)}</span>
      </h3>
      <p class="key" aria-hidden="true">
        <span class="k before"></span>{t(r.before, locale)}
        <span class="k after"></span>{t(r.after, locale)}
      </p>
      <ul role="list">
        {r.items.map((item, n) => (
          <li class="item" style={`--at:${s(0.39 + n * 0.12)}`}>
            <span class="name">{t(item.name, locale)}</span>
            <span class="val">{t(item.value, locale)}</span>
            <span class="track before" aria-hidden="true">
              <span class="fill after" style={`width:${item.after[0]}%`}></span>
              {item.after[1] > item.after[0] && (
                <span class="range" style={`left:${item.after[0]}%;width:${item.after[1] - item.after[0]}%`}></span>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
    <button type="button" class="replay" data-replay>{t(finops.replay, locale)}</button>
  </div>

  <figcaption class="visually-hidden">
    {t(finops.figure, locale)}:
    <ul role="list">
      {finops.alt.map((line) => <li>{t(line, locale)}</li>)}
    </ul>
  </figcaption>
</figure>

<script is:inline>
  // Arms the run before first paint (paused on its first frame), plays it once when it
  // scrolls into view, and replays it on demand. Without JS the finished state shows.
  (function () {
    var fig = document.currentScript.previousElementSibling;
    if (!fig || !('IntersectionObserver' in window)) return;
    var parts = fig.querySelectorAll('[data-play]');
    parts.forEach(function (el) {
      el.classList.add('is-armed');
      var io = new IntersectionObserver(function (entries) {
        if (!entries[0].isIntersecting) return;
        el.classList.add('is-playing');
        io.disconnect();
      }, { threshold: 0.35 });
      io.observe(el);
    });
    var button = fig.querySelector('[data-replay]');
    if (button) button.addEventListener('click', function () {
      parts.forEach(function (el) { el.classList.remove('is-armed', 'is-playing'); });
      void fig.offsetWidth;
      parts.forEach(function (el) { el.classList.add('is-armed', 'is-playing'); });
    });
  })();
</script>

<style>
  .finops {
    --face-t: #23221f;
    --face-l: #141412;
    --face-r: #1a1917;
    --edge: #5a574f;
    margin: 0;
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  @media (min-width: 700px) {
    .finops { grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr); column-gap: 2.25rem; }
  }

  /* ---------- the plate ---------- */
  .stage { position: relative; width: 100%; container-type: inline-size; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  .floor { fill: none; stroke: var(--line); stroke-width: 0.6; opacity: 0.7; }
  .t, .l, .r { stroke: var(--edge); stroke-width: 0.8; stroke-linejoin: round; }
  .t { fill: var(--face-t); }
  .l { fill: var(--face-l); }
  .r { fill: var(--face-r); }
  .plate { fill: #191816; }

  /* Finished state is the default: the excess lies flat, only the used cubes stand. */
  .side { opacity: 0; }
  .lid { transform: translateY(var(--drop)); fill: #191816; stroke: var(--line-strong); }
  .cell .t { fill: var(--signal); stroke: #ffb08f; }
  .cell .l { fill: #a8401a; stroke: #a8401a; }
  .cell .r { fill: #cf4e1e; stroke: #cf4e1e; }
  /* The partial cube keeps its unused 40% as a wire outline: a cell, 60% full. */
  .cell .cap :is(.t, .l, .r) { fill: transparent; stroke: var(--line-strong); }

  .pins { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; pointer-events: none; }
  .pin {
    position: absolute; left: var(--x); top: var(--y);
    display: grid; gap: 2px; width: max-content; max-width: 22ch;
    font-size: 0.8125rem; line-height: 1.3; color: var(--ink-2);
  }
  .pin b { font-family: var(--font-mono); font-weight: 600; font-size: 0.8125rem; color: var(--ink); margin-right: 0.2em; }
  .pin .line { color: var(--ink); }
  .pin .note { font-size: 0.75rem; }
  /* A cell drawn flat, as a key beside the label that names it. */
  .cell-key {
    display: inline-block; width: 8px; height: 8px; margin-right: 0.5em; vertical-align: 0.05em;
    border: 1px solid var(--line-strong); background: #191816;
    transform: scaleY(0.58) rotate(45deg);
  }
  .cell-key.used { background: var(--signal); border-color: #ffb08f; }
  .pin .ratio { padding-left: calc(10px + 0.5em); }
  .pin.requested { transform: translate(-100%, -100%); text-align: right; }
  .pin.used { transform: translate(4px, 4px); max-width: 30ch; }
  .pin.rightsizing { transform: translate(6px, -100%); max-width: 15ch; }
  .pin.rightsizing .line { color: var(--ink-2); }
  @container (max-width: 440px) { .pin.rightsizing { max-width: 11ch; } }

  /* ---------- the ledger ---------- */
  .ledger { display: grid; gap: 1.5rem; align-content: center; }
  .group { display: grid; gap: 0.6rem; }
  h3 {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.15rem 0.75rem;
    font-size: 0.8125rem; font-weight: 620; letter-spacing: 0; line-height: 1.3; color: var(--ink);
    padding-bottom: 0.45rem; border-bottom: 1px solid var(--line);
  }
  .scale { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 400; color: var(--ink-2); }
  .key { display: flex; align-items: center; gap: 0.4rem; font-size: 0.6875rem; color: var(--ink-2); margin-top: -0.2rem; }
  .k { display: inline-block; width: 14px; height: 6px; border-radius: 1px; }
  .k.before { border: 1px solid var(--edge); background: var(--face-t); }
  .k.after { background: var(--signal); margin-left: 0.6rem; }
  .group ul { display: grid; gap: 0.7rem; margin: 0; }
  .item { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 0.75rem; row-gap: 0.35rem; align-items: baseline; }
  .name { font-size: 0.8125rem; line-height: 1.3; color: var(--ink-2); }
  .val { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .track {
    grid-column: 1 / -1; position: relative; display: block; height: 8px;
    background: var(--face-l); border: 1px solid var(--line-strong); border-radius: 2px;
  }
  .track.before { background: var(--face-t); border-color: var(--edge); }
  .fill { position: absolute; inset: -1px auto -1px -1px; display: block; border-radius: 1px 2px 2px 1px; transform-origin: left center; }
  .share { background: #8d897f; }
  .after { background: var(--signal); }
  .range {
    position: absolute; top: -1px; bottom: -1px; display: block;
    border: 1px solid var(--signal); border-left: 0; border-radius: 0 2px 2px 0;
    background: color-mix(in srgb, var(--signal) 35%, transparent);
  }

  .replay {
    display: none; justify-self: start; min-height: 40px; padding: 0 0.9rem; cursor: pointer;
    background: transparent; color: var(--ink-2);
    border: 1px solid var(--line-strong); border-radius: var(--radius);
    font-size: 0.8125rem; font-weight: 560;
  }
  .replay:hover { color: var(--ink); border-color: var(--ink); }

  @media (max-width: 699px) {
    /* Room for the labels that leave the stage on a narrow screen. */
    .stage { margin-block: 1.25rem 2.5rem; }
    .pin { left: var(--mx); top: var(--my); font-size: 0.75rem; }
    .pin b { font-size: 0.75rem; }
    .pin .note { font-size: 0.6875rem; }
    .pin.used { transform: translate(-14px, 8px); }
  }
  /* The smallest phones: pull the corner label back inside the screen. */
  @media (max-width: 359px) {
    .pin.rightsizing { transform: translate(-28%, -100%); }
  }

  /* ---------- the run ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .replay { display: inline-flex; align-items: center; }

    .is-armed { --play: paused; }
    .is-armed.is-playing { --play: running; }

    .is-armed :is(.row, .used) { animation: land 0.35s var(--ease-out) var(--at) both var(--play); }
    /* Used cubes and the partial cube's cap both start as plain requested cubes. */
    .is-armed .cell .t { animation: dark-t 0.25s ease var(--heat) both var(--play); }
    .is-armed .cell .l { animation: dark-l 0.25s ease var(--heat) both var(--play); }
    .is-armed .cell .r { animation: dark-r 0.25s ease var(--heat) both var(--play); }
    .is-armed .cell .cap .t { animation: dark-t 0.45s ease var(--flat) both var(--play); }
    .is-armed .cell .cap .l { animation: dark-l 0.45s ease var(--flat) both var(--play); }
    .is-armed .cell .cap .r { animation: dark-r 0.45s ease var(--flat) both var(--play); }
    .is-armed .side { animation: gone 0.45s ease var(--flat) both var(--play); }
    .is-armed .lid { animation: lay 0.5s cubic-bezier(0.5, 0, 0.6, 1) var(--flat) both var(--play); }
    .is-armed .pin { animation: fade 0.3s ease var(--at) both var(--play); }

    .is-armed .fill { animation: grow 0.7s var(--ease-out) var(--at) both var(--play); }
    .is-armed .range { animation: fade 0.25s ease calc(var(--at) + 0.6s) both var(--play); }
  }

  @keyframes fade { from { opacity: 0; } }
  @keyframes gone { from { opacity: 1; } }
  @keyframes land { from { opacity: 0; transform: translateY(-10px); } }
  @keyframes dark-t { from { fill: var(--face-t); stroke: var(--edge); } }
  @keyframes dark-l { from { fill: var(--face-l); stroke: var(--edge); } }
  @keyframes dark-r { from { fill: var(--face-r); stroke: var(--edge); } }
  @keyframes lay { from { transform: translateY(0); fill: var(--face-t); stroke: var(--edge); } }
  @keyframes grow { from { transform: scaleX(0); } }
</style>
