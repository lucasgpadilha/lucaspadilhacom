---
import { migration } from '../../data/home';
import { t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = migration;
const pt = locale === 'pt';
---
<section id="kubernetes" class="zone-night migration" aria-labelledby="kubernetes-title">
  <div class="wrap">
    <header class="head">
      <h2 id="kubernetes-title">{t(m.title, locale)}</h2>
      <p class="lede">{t(m.lede, locale)}</p>
    </header>
    <div class="layout">
      <div class="stage" data-stage>
        <div class="stage-inner" data-stage-host>
          <figure class="fallback" data-fallback aria-hidden="true">
            <svg viewBox="0 0 640 400" role="presentation">
              <g class="vms">
                {[0, 1, 2, 3, 4].map((i) => (
                  <g transform={`translate(40 ${40 + i * 66})`}>
                    <rect width="150" height="52" rx="3" />
                    {[0, 1, 2, 3, 4, 5].map((j) => <rect class="box" x={12 + j * 22} y="16" width="16" height="20" />)}
                  </g>
                ))}
              </g>
              <path class="flow" d="M210 200 C 300 200, 330 200, 400 200" />
              <path class="flow-head" d="M392 192 L404 200 L392 208" />
              <g class="cluster">
                {Array.from({ length: 19 }, (_, i) => {
                  const ring = [[0, 0], [1, 0], [0.5, 0.87], [-0.5, 0.87], [-1, 0], [-0.5, -0.87], [0.5, -0.87], [2, 0], [1.5, 0.87], [1, 1.73], [0, 1.73], [-1, 1.73], [-1.5, 0.87], [-2, 0], [-1.5, -0.87], [-1, -1.73], [0, -1.73], [1, -1.73], [1.5, -0.87]][i];
                  return <polygon class="node" points="0,-26 22.5,-13 22.5,13 0,26 -22.5,13 -22.5,-13" transform={`translate(${520 + ring[0] * 46} ${200 + ring[1] * 52})`} />;
                })}
              </g>
            </svg>
          </figure>
          <p class="counter" aria-live="off">
            <strong data-counter>258</strong>
            <span>{t(m.counter, locale)}</span>
          </p>
        </div>
      </div>
      <div class="side">
        <ol class="steps" role="list">
          {m.steps.map((step) => (
            <li class="step" data-step={step.key}>
              <h3>{t(step.title, locale)}</h3>
              <p>{t(step.body, locale)}</p>
            </li>
          ))}
        </ol>
        <div class="after">
          <ul class="facts" role="list">
            {m.facts.map((fact) => <li><b>{fact.value}</b> {t(fact.text, locale)}</li>)}
          </ul>
          <p class="tools"><span class="visually-hidden">{pt ? 'Ferramentas' : 'Tools'}: </span>{m.tools.join(' · ')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { mountScene } from '../../lib/three/mount';
  import { ALREADY_ON_CLUSTER, landed, stepIndex } from './migration-timeline';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.getElementById('kubernetes');
  const host = root?.querySelector<HTMLElement>('[data-stage-host]');
  if (root && host) {
    const handle = mountScene(host, () => import('./migration-scene'));
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const update = (progress: number) => {
      handle.setProgress(progress);
      if (counter) counter.textContent = String(ALREADY_ON_CLUSTER + landed(progress));
      const active = stepIndex(progress);
      steps.forEach((step, i) => step.toggleAttribute('data-active', i === active));
    };
    update(0);
    ScrollTrigger.create({
      trigger: root.querySelector('.steps'),
      start: 'top 65%',
      end: 'bottom 60%',
      onUpdate: (self) => update(self.progress),
    });
  }
</script>

<style>
  .migration { padding-block: clamp(3.5rem, 2.5rem + 3vw, 6rem); border-top: 1px solid var(--line); }
  .head { display: grid; gap: 1rem; margin-bottom: 2rem; }
  h2 { font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem); letter-spacing: -0.03em; max-width: 20ch; }
  .head .lede { font-size: var(--step-1); color: var(--ink); max-width: 52ch; }
  @media (min-width: 1080px) {
    .head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 3.5rem; align-items: end; }
  }

  /* Inactive steps stay fully legible (AA); the active one gets the ink and a signal marker. */
  .step h3 { color: var(--ink-2); transition: color 0.3s var(--ease-out); }
  .step h3::before {
    content: ''; display: block; width: 28px; height: 2px; margin-bottom: 0.8rem;
    background: var(--line-strong); transition: background-color 0.3s var(--ease-out), width 0.3s var(--ease-out);
  }
  .step[data-active] h3 { color: var(--ink); }
  .step[data-active] h3::before { background: var(--signal); width: 56px; }
  html:not(.js) .step h3 { color: var(--ink); }
  .layout { display: grid; gap: 1.5rem; }
  .stage { position: sticky; top: 64px; z-index: 3; height: min(42vh, 360px); }
  .stage-inner {
    position: relative; height: 100%;
    border: 1px solid var(--line); border-radius: 6px; overflow: hidden;
    background: var(--surface);
  }
  .fallback { position: absolute; inset: 0; margin: 0; display: grid; place-items: center; padding: 1rem; }
  .fallback[hidden] { display: none; }
  .fallback svg { width: 100%; height: 100%; }
  .fallback rect { fill: none; stroke: var(--line-strong); stroke-width: 1.5; }
  .fallback .box { fill: var(--signal); stroke: none; opacity: 0.25; }
  .fallback .flow { fill: none; stroke: var(--signal); stroke-width: 2; stroke-dasharray: 4 6; }
  .fallback .flow-head { fill: none; stroke: var(--signal); stroke-width: 2; }
  .fallback .node { fill: color-mix(in srgb, var(--signal) 22%, transparent); stroke: var(--signal); stroke-width: 1.2; }
  .counter {
    position: absolute; left: 1rem; bottom: 0.9rem; z-index: 2; margin: 0;
    display: flex; align-items: baseline; gap: 0.6rem;
    font-family: var(--font-mono); color: var(--ink-2); font-size: 0.75rem;
  }
  .counter strong { font-family: var(--font-sans); font-size: var(--step-3); color: var(--ink); font-weight: 680; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .steps { display: grid; position: relative; z-index: 1; }
  .step { min-height: 52vh; display: grid; align-content: center; gap: 0.6rem; padding: 1.25rem 0; }
  .step h3 { font-size: var(--step-2); max-width: 20ch; }
  .step p { color: var(--ink-2); max-width: 44ch; font-size: var(--step-0); line-height: 1.5; }
  .after { display: grid; gap: 1rem; padding-top: 1rem; }
  .facts { display: grid; gap: 0.55rem; font-size: var(--step--1); color: var(--ink-2); max-width: 46ch; }
  .facts b { font-family: var(--font-mono); font-weight: 600; color: var(--signal); margin-right: 0.15em; }
  .tools { font-size: 0.8125rem; color: var(--ink-2); padding-top: 0.75rem; border-top: 1px solid var(--line); max-width: 46ch; }
  /* Phones: the opaque stage stays on top; each step's text lives in the lower half and
     slides under the stage as it leaves, so copy never sits on the canvas. */
  @media (max-width: 1079px) {
    .stage { box-shadow: 0 18px 24px -12px var(--paper); height: min(38vh, 340px); }
    .step { min-height: 48vh; align-content: end; padding-bottom: 5vh; }
  }
  @media (min-width: 1080px) {
    .layout { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3.5rem; align-items: start; }
    .stage { top: 88px; height: min(calc(100vh - 140px), 600px); }
    .step { min-height: 58vh; }
    .step:first-child { min-height: 40vh; align-content: start; padding-top: 0; }
  }
</style>
