  .metric .t, .job .t { fill: #d9d5cb; stroke: #d9d5cb; }
  .metric .l, .job .l { fill: #8d897f; stroke: #8d897f; }
  .metric .r, .job .r { fill: #b3afa5; stroke: #b3afa5; }

  /* Pods by environment: prod in signal, staging mid, dev light. */
  .pod.prod { --pt: var(--signal); --pe: #ffb08f; --pl: #a8401a; --pr: #cf4e1e; }
  .pod.hml { --pt: #8d897f; --pe: #a29f97; --pl: #4f4c46; --pr: #6b6861; }
  .pod.dev { --pt: #d9d5cb; --pe: #d9d5cb; --pl: #8d897f; --pr: #b3afa5; }
  .pod .t { fill: var(--pt); stroke: var(--pe); }
  .pod .l { fill: var(--pl); stroke: var(--pl); }
  .pod .r { fill: var(--pr); stroke: var(--pr); }

  /* Which drawing is on the stage. */
  .shared { opacity: 0; }
  .is-shared .split { opacity: 0; }
  .is-shared .shared { opacity: 1; }

  /* Failure end states: the pods go dark with red edges, the starved node is outlined. */
  :is(.is-shared .shared, .is-isolated .split) .pod.f .t { fill: #4f2623; stroke: var(--alert); }
  :is(.is-shared .shared, .is-isolated .split) .pod.f .l { fill: #2a1614; stroke: var(--alert); }
  :is(.is-shared .shared, .is-isolated .split) .pod.f .r { fill: #3a1c1a; stroke: var(--alert); }
  :is(.is-shared .shared, .is-isolated .split) .node.hot .t { stroke: var(--alert); stroke-width: 1.2; }

  .labels { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; pointer-events: none; }
  .label-pin {
    --gap: 10px;
    position: absolute; left: var(--x); top: var(--y); transform: translate(var(--gap), -50%);
    display: grid; gap: 1px; width: max-content; max-width: 24ch;
    font-size: 0.75rem; line-height: 1.3; color: var(--ink-2);
  }
  .label-pin strong { color: var(--ink); font-size: 0.8125rem; font-weight: 620; }
  .label-pin.prod span { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--signal); }
  .label-pin.shared { max-width: 30ch; }
  .label-pin.left { transform: translate(calc(-100% - var(--gap)), -50%); text-align: right; }
  .label-pin.left-low { transform: translate(calc(-100% - var(--gap)), -20%); text-align: right; }
  .label-pin.left-under { transform: translate(calc(-100% - var(--gap)), 6px); text-align: right; }
  .label-pin.above { transform: translate(-50%, calc(-100% - 6px)); text-align: center; }
  .label-pin.above-r { transform: translate(4px, calc(-100% - 4px)); }
  .label-pin.below { transform: translate(-50%, 8px); text-align: center; }
  .label-pin.center { transform: translate(-50%, -50%); text-align: center; }
  .only-shared { opacity: 0; }
  .is-shared .only-split { opacity: 0; }
  .is-shared .only-shared { opacity: 1; }

  /* The pod key for the shared cluster, where environments are mixed on the nodes. */
  .key { display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 3px; font-style: normal; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--ink-2); }
  .key i { display: inline-flex; align-items: center; gap: 0.35rem; font-style: normal; }
  .key i::before { content: ''; width: 7px; height: 7px; background: var(--sw); }
  .key .prod { --sw: var(--signal); }
  .key .hml { --sw: #8d897f; }
  .key .dev { --sw: #d9d5cb; }

  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; }
  .caption { display: flex; align-items: center; min-height: 1.5rem; flex: 1 1 20rem; max-width: 32rem; }
  .msgs { display: grid; }
  .msgs > * { grid-area: 1 / 1; }
  .sizer { visibility: hidden; }
  .status { display: inline-flex; align-items: baseline; gap: 0.55rem; font-size: 0.8125rem; color: var(--ink); line-height: 1.45; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--signal); flex: none; transform: translateY(-1px); }
  .is-shared .dot { background: var(--alert); }

  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .controls-label { font-size: 0.8125rem; color: var(--ink-2); margin-right: 0.25rem; }
  .controls button {
    min-height: 40px; padding: 0 0.9rem; cursor: pointer;
    background: transparent; color: var(--ink-2);
    border: 1px solid var(--line-strong); border-radius: var(--radius);
    font-size: 0.8125rem; font-weight: 560;
  }
  .controls button:hover { color: var(--ink); border-color: var(--ink); }
  .controls button[aria-pressed='true'] { color: var(--ink); border-color: var(--ink); }
  :global(html:not(.js)) .controls { display: none; }

  /* Run timing per design; --t0 is when the failure starts, later when the other
     drawing first has to leave the stage. */
  .from-split.is-shared { --t0: 1.6s; }
  .from-shared.is-shared { --t0: 0.25s; }
  .from-split.is-isolated { --t0: 0.1s; }
  .from-shared.is-isolated { --t0: 0.8s; }

  @media (prefers-reduced-motion: no-preference) {
    .platform.is-armed { --play: paused; }
    .platform.is-armed.is-playing { --play: running; }

    /* Entry: rise, ring, sync, pods, telemetry back, caption. */
    .is-armed.is-split .split .obj { animation: pl-rise 0.45s var(--ease-out) var(--at) both var(--play); }
    .is-armed.is-split .split .tool { animation: pl-drop 0.3s var(--ease-out) var(--at) both var(--play); }
    .is-armed.is-split .split .ring { animation: pl-draw 0.4s ease-in-out var(--at) both var(--play); }
    .is-armed.is-split .split .arrow { animation: pl-fade 0.15s ease var(--at) both var(--play); }
    .is-armed.is-split .sync { animation: pl-draw 0.5s ease-in-out var(--at) both var(--play); }
    .is-armed.is-split .tele { animation: pl-flow 0.75s cubic-bezier(0.3, 0, 0.6, 1) var(--at) both var(--play); }
    .is-armed.is-split .split .pod { animation: pl-land 0.3s cubic-bezier(0.3, 1.25, 0.5, 1) var(--in) both var(--play); }
    .is-armed.is-split .only-split { animation: pl-fade 0.3s ease var(--at) both var(--play); }
    .is-armed.is-split .status { animation: pl-fade 0.3s ease var(--entry) both var(--play); }

    /* Toward the shared cluster: the split drawing gathers into the middle and fades. */
    .from-split.is-shared .split { animation: pl-out 0.5s ease-in both; }
    .from-split.is-shared .split :is(.obj, .lanes) { animation: pl-gather 0.5s ease-in both; }
    .from-split.is-shared .only-split { animation: pl-out 0.35s ease both; }
    .from-split.is-shared .shared { animation: pl-in 0.35s ease 0.3s both; }
    .from-split.is-shared .shared .obj { animation: pl-rise 0.45s var(--ease-out) var(--at) both; }
    .from-split.is-shared .shared .tool { animation: pl-drop 0.3s var(--ease-out) var(--at) both; }
    .from-split.is-shared .shared .pod { animation: pl-land 0.3s cubic-bezier(0.3, 1.25, 0.5, 1) var(--in) both; }
    .from-split.is-shared .only-shared { animation: pl-fade 0.3s ease 0.5s both; }

    /* Back to one cluster per environment: the shared cluster fades, the split drawing
       spreads back out from the middle. */
    .from-shared.is-isolated .shared { animation: pl-out 0.4s ease both; }
    .from-shared.is-isolated .only-shared { animation: pl-out 0.3s ease both; }
    .from-shared.is-isolated .split { animation: pl-in 0.4s ease 0.15s both; }
    .from-shared.is-isolated .split :is(.obj, .lanes) { animation: pl-spread 0.55s var(--ease-out) 0.15s both; }
    .from-shared.is-isolated .only-split { animation: pl-fade 0.3s ease 0.5s both; }

    /* The bad deploy: Argo CD syncs dev again (isolated run), then the failure spreads. */
    .is-isolated .sync.dev { animation: pl-draw 0.45s ease-in-out var(--t0) both; }
    .is-isolated .split .pod.f :is(.t, .l, .r) { animation-delay: calc(var(--t0) + 0.55s + var(--f)); }
    .is-shared .shared .pod.f :is(.t, .l, .r) { animation-delay: calc(var(--t0) + var(--f)); }
    :is(.is-shared .shared, .is-isolated .split) .pod.f .t { animation-name: pl-was-t; }
    :is(.is-shared .shared, .is-isolated .split) .pod.f .l { animation-name: pl-was-l; }
    :is(.is-shared .shared, .is-isolated .split) .pod.f .r { animation-name: pl-was-r; }
    :is(.is-shared .shared, .is-isolated .split) .pod.f :is(.t, .l, .r) { animation-duration: 0.25s; animation-timing-function: ease; animation-fill-mode: both; }
    .is-isolated .split .node.hot .t { animation: pl-was-edge 0.25s ease calc(var(--t0) + 0.85s) both; }
    .is-shared .shared .node.hot .t { animation: pl-was-edge 0.25s ease calc(var(--t0) + var(--hot)) both; }
    .is-shared .status { animation: pl-fade 0.3s ease calc(var(--t0) + 1.6s) both; }
    .is-isolated .status { animation: pl-fade 0.3s ease calc(var(--t0) + 1.35s) both; }
  }

  @keyframes pl-fade { from { opacity: 0; } }
  @keyframes pl-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes pl-out { from { opacity: 1; } to { opacity: 0; } }
  @keyframes pl-rise { from { opacity: 0; transform: translateY(10px); } }
  @keyframes pl-drop { from { opacity: 0; transform: translateY(-8px); } }
  @keyframes pl-land { from { opacity: 0; transform: translateY(-14px); } to { opacity: 1; transform: none; } }
  @keyframes pl-draw { from { stroke-dasharray: 0 100; } to { stroke-dasharray: 100 0; } }
  @keyframes pl-flow { from { stroke-dashoffset: var(--from); } to { stroke-dashoffset: 0; } }
  @keyframes pl-gather { to { transform: translate(var(--gx), var(--gy)); } }
  @keyframes pl-spread { from { transform: translate(var(--gx), var(--gy)); } }
  @keyframes pl-was-t { from { fill: var(--pt); stroke: var(--pe); } }
  @keyframes pl-was-l { from { fill: var(--pl); stroke: var(--pl); } }
  @keyframes pl-was-r { from { fill: var(--pr); stroke: var(--pr); } }
  @keyframes pl-was-edge { from { stroke: var(--edge); stroke-width: 0.8; } }

  @media (max-width: 1079px) {
