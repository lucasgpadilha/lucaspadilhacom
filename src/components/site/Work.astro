---
import ProjectCard from './ProjectCard.astro';
import { projects, sections } from '../../data/home';
import { t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = sections.work;
---
<section id="work" class="section" aria-labelledby="work-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="label">{t(s.label, locale)}</p>
      <div class="head-copy">
        <h2 id="work-title">{t(s.title, locale)}</h2>
        <p class="lede">{t(s.intro, locale)}</p>
      </div>
    </header>
    <div class="bento">
      {projects.map((project) => <ProjectCard project={project} locale={locale} />)}
    </div>
  </div>
</section>

<style>
  .head-copy { display: grid; gap: 1.25rem; }
  .bento { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 720px) { .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .bento { grid-template-columns: repeat(12, minmax(0, 1fr)); } }
</style>
