---
import { stackGroups } from '../../data/stack';
import { t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section id="stack" class="section stack" aria-labelledby="stack-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="stack-title">{locale === 'pt' ? 'Ferramentas com que trabalho' : 'Tools I work with'}</h2>
    </header>
    <dl class="groups">
      {stackGroups.map((group) => (
        <div class="group">
          <dt>{t(group.title, locale)}</dt>
          <dd><ul role="list">{group.tools.map((tool) => <li>{tool}</li>)}</ul></dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .groups { display: grid; gap: 0; border-top: 2px solid var(--ink); }
  .group { display: grid; gap: 0.6rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  dt { font-weight: 640; font-size: var(--step-0); }
  dd { margin: 0; }
  ul { display: flex; flex-wrap: wrap; gap: 0.35rem 1.4rem; font-size: var(--step-1); color: var(--ink-2); }
  @media (min-width: 900px) {
    .group { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); align-items: baseline; padding: 1.5rem 0; }
  }
</style>
