---
import Arrow from './Arrow.astro';
import { sections } from '../../data/home';
import { t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = sections.sites;
const demos = [
  { href: '/sites/exemplos/advocacia/', name: 'Lacerda & Viana', niche: { en: 'Law firm', pt: 'Advocacia' } },
  { href: '/sites/exemplos/odontologia/', name: 'Aurora Odontologia', niche: { en: 'Dental clinic', pt: 'Clínica odontológica' } },
  { href: '/sites/exemplos/cafe/', name: 'Casa Jabuticaba', niche: { en: 'Café & bakery', pt: 'Café e padaria' } },
];
---
<section id="websites" class="teaser" aria-labelledby="websites-title">
  <div class="wrap inner">
    <div class="copy" data-reveal>
      <p class="label">{t(s.label, locale)}</p>
      <h2 id="websites-title">{t(s.title, locale)}</h2>
      <p class="body">{t(s.body, locale)}</p>
      <a class="btn" href="/sites/" hreflang="pt-BR">{t(s.cta, locale)} <Arrow /></a>
    </div>
    <ol class="demos" role="list" data-reveal>
      {demos.map((demo, index) => (
        <li>
          <a href={demo.href} hreflang="pt-BR">
            <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="name">{demo.name}</span>
            <span class="niche">{t(demo.niche, locale)}</span>
            <span class="go"><Arrow dir="up-right" size={22} /></span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .teaser { background: var(--signal); color: var(--on-signal); padding-block: clamp(4rem, 3rem + 5vw, 7.5rem); }
  .inner { display: grid; gap: 3rem; align-items: end; }
  .copy { display: grid; gap: 1.25rem; justify-items: start; }
  .label { color: color-mix(in srgb, var(--on-signal) 75%, transparent); }
  h2 { font-size: var(--step-4); max-width: 12ch; }
  .body { font-size: var(--step-1); line-height: 1.45; max-width: 46ch; }
  .btn { background: var(--on-signal); border-color: var(--on-signal); color: #fbfaf6; margin-top: 0.5rem; }
  .btn:hover { background: #fbfaf6; border-color: #fbfaf6; color: var(--on-signal); }
  .demos { border-top: 2px solid var(--on-signal); }
  .demos a {
    display: grid; grid-template-columns: 2.5rem 1fr auto; grid-template-areas: 'num name go' 'num niche go';
    align-items: center; column-gap: 0.75rem; padding: 1.1rem 0; min-height: 72px;
    border-bottom: 1px solid color-mix(in srgb, var(--on-signal) 35%, transparent);
    text-decoration: none; color: inherit;
  }
  .num { grid-area: num; font-family: var(--font-mono); font-size: 0.75rem; }
  .name { grid-area: name; font-size: var(--step-2); font-weight: 650; letter-spacing: -0.02em; line-height: 1.1; }
  .niche { grid-area: niche; font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .go { grid-area: go; display: inline-flex; transition: transform 0.25s var(--ease-out); }
  .demos a:hover .go { transform: translate(3px, -3px); }
  .demos a:focus-visible { outline-color: var(--on-signal); }
  @media (min-width: 960px) { .inner { grid-template-columns: 1fr 1fr; gap: 4rem; } }
</style>
