    display: grid;
    gap: 1rem;
    container-type: inline-size;
  }
  .plot { position: relative; display: grid; gap: 1rem; }
  .stage { position: relative; width: 100%; margin-inline: auto; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  .floor { fill: none; stroke: var(--line); stroke-width: 0.6; opacity: 0.7; }
  .plate { fill: none; stroke: var(--line-strong); stroke-width: 1; stroke-linejoin: round; }
  .plate.compartment { stroke-dasharray: 6 5; }
  .plate.vcn { fill: color-mix(in srgb, var(--ink) 2.5%, transparent); stroke-width: 1.1; }
  .plate.subnet { fill: color-mix(in srgb, var(--ink) 3%, transparent); stroke-width: 0.8; }
  .plate.nsg { stroke-dasharray: 1.5 3; stroke-width: 0.8; }
  .plate.arm { fill: color-mix(in srgb, var(--ink) 4%, transparent); stroke-width: 0.8; }
  .plate.sky { stroke-dasharray: 6 5; fill: color-mix(in srgb, var(--ink) 2.5%, transparent); }
  .ring { fill: none; stroke: #b3afa5; stroke-width: 1.2; }

  .track { fill: none; stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 2 4; stroke-linejoin: round; }
  .live { fill: none; stroke: var(--signal); stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: butt; }
  .dots { fill: none; stroke: var(--signal); stroke-width: 5; stroke-linecap: round; opacity: 0; }
  /* Only the chosen route stays lit, with the boxes it passes through; After is the default. */
  .cloud:not(.is-before) .route.before .live,
  .cloud.is-before .route.after .live { opacity: 0; }
  .cloud:not(.is-before) .hop-after .t,
  .cloud.is-before .hop-before .t { stroke: var(--signal); }

  .t, .l, .r { stroke: var(--edge); stroke-width: 0.8; stroke-linejoin: round; }
  .t { fill: var(--face-t); }
  .l { fill: var(--face-l); }
  .r { fill: var(--face-r); }
  .rib { fill: none; stroke: var(--edge); stroke-width: 0.8; stroke-linecap: round; }
  .collector .t, .pod.quiet .t { fill: #d9d5cb; stroke: #d9d5cb; }
  .collector .l, .pod.quiet .l { fill: #8d897f; stroke: #8d897f; }
  .collector .r, .pod.quiet .r { fill: #b3afa5; stroke: #b3afa5; }
  .collector .rib { stroke: #5a574f; stroke-width: 1.2; }
  .pod .t { fill: var(--signal); stroke: #ffb08f; }
  .pod .l { fill: #a8401a; stroke: #a8401a; }
  .pod .r { fill: #cf4e1e; stroke: #cf4e1e; }

  .labels { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; pointer-events: none; }
  .label-pin {
    --gap: 10px;
    position: absolute; left: var(--x); top: var(--y); transform: translate(var(--gap), -50%);
    display: grid; gap: 1px; width: max-content; max-width: 26ch;
    font-size: 0.75rem; line-height: 1.3; color: var(--ink-2);
  }
  .label-pin strong { color: var(--ink); font-size: 0.8125rem; font-weight: 620; }
  .label-pin.left { transform: translate(calc(-100% - var(--gap)), -50%); text-align: right; }
  .label-pin.above { transform: translate(-50%, calc(-100% - 8px)); text-align: center; }
  .label-pin.below { transform: translate(-50%, 8px); text-align: center; }
  .label-pin.below-l { transform: translate(calc(-100% + 8px), 8px); text-align: right; }
  .label-pin.above-r { transform: translate(-8px, calc(-100% - 8px)); text-align: left; }
  .label-pin:is(.compartments, .prod, .hml, .dev, .mgmt) strong { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500; color: var(--ink-2); letter-spacing: 0.02em; }
  /* Phones: names only (the VCN prefix and the details are spans), at 11px. */
  @media (max-width: 699px) {
    .label-pin { --gap: 6px; left: var(--xs, var(--x)); top: var(--ys, var(--y)); }
    .label-pin, .label-pin strong { font-size: 0.6875rem; }
    .label-pin span { display: none; }
    .label-pin.s-below { transform: translate(-50%, 6px); text-align: center; }
    .label-pin.collector { max-width: 11ch; }
    .plot { gap: 1.5rem; }
