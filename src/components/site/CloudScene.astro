  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; }
  .caption { display: flex; align-items: center; min-height: 1.5rem; flex: 1 1 22rem; max-width: 30rem; }
  .status { display: inline-flex; align-items: baseline; gap: 0.55rem; font-size: 0.8125rem; color: var(--ink); line-height: 1.45; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--signal); flex: none; transform: translateY(-1px); }
  .is-before .dot { background: var(--alert); }

  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .controls-label { font-size: 0.8125rem; color: var(--ink-2); margin-right: 0.25rem; }
  .controls button {
    min-height: 40px; padding: 0 0.9rem; cursor: pointer;
    background: transparent; color: var(--ink-2);
    border: 1px solid var(--line-strong); border-radius: var(--radius);
    font-size: 0.8125rem; font-weight: 560;
  }
  .controls button:hover { color: var(--ink); border-color: var(--ink); }
  .controls button[aria-pressed='true'] { color: var(--ink); border-color: var(--ink); }
  /* The route is replayed by script; without it the finished drawing stands alone. */
  :global(html:not(.js)) .controls { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .cloud.is-armed { --play: paused; }
    .cloud.is-armed.is-playing { --play: running; }

    .is-armed :is(.plate, .ring) { animation: cl-fade 0.45s ease var(--at) both; animation-play-state: var(--play); }
    .is-armed .obj { animation: cl-rise 0.42s var(--ease-out) var(--at) both; animation-play-state: var(--play); }
    .is-armed .pool { animation: cl-drop 0.32s var(--ease-out) var(--at) both; animation-play-state: var(--play); }
    .is-armed .pod { animation: cl-fade 0.22s ease var(--at) both; animation-play-state: var(--play); }
    .is-armed .label-pin { animation: cl-fade 0.3s ease var(--at) both; animation-play-state: var(--play); }
    .is-armed .log li { animation: cl-fade 0.18s ease var(--at) both; animation-play-state: var(--play); }
    .is-armed .track { animation: cl-fade 0.3s ease var(--tracks) both; animation-play-state: var(--play); }
    .is-armed:not(.is-routing) .route.after .live { animation: cl-draw 0.4s ease-in-out var(--route) both; animation-play-state: var(--play); }
    .is-armed:not(.is-routing) .hop-after .t { animation: cl-unlit 0.2s ease var(--lit-in) both; animation-play-state: var(--play); }
    .is-armed:not(.is-routing) .status { animation: cl-fade 0.3s ease var(--status) both; animation-play-state: var(--play); }

    .is-routing.is-before .route.before .live,
    .is-routing.is-after .route.after .live { animation: cl-draw var(--dur) linear both; }
    .is-routing.is-before .route.before .dots,
    .is-routing.is-after .route.after .dots { animation: cl-stream var(--dur) linear both; }
    .is-routing.is-before .hop-before .t,
    .is-routing.is-after .hop-after .t { animation: cl-unlit 0.15s ease var(--lit) both; }
  }

  @keyframes cl-rise { from { opacity: 0; transform: translateY(10px); } }
  @keyframes cl-drop { from { opacity: 0; transform: translateY(-10px); } }
  @keyframes cl-fade { from { opacity: 0; } }
  @keyframes cl-unlit { from { stroke: var(--edge); } }
  @keyframes cl-draw { from { stroke-dasharray: 0 100; } to { stroke-dasharray: 100 0; } }
  @keyframes cl-stream { from { opacity: 1; stroke-dashoffset: var(--from); } to { opacity: 1; stroke-dashoffset: var(--to); } }
</style>
