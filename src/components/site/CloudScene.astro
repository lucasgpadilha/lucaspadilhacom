---
// The cloud drawing: a hub-and-spoke landing zone on OCI assembles in dependency order,
// the way `terraform apply` creates it, then holds. Compartments are dashed outlines, a
// DRG sits at the hub and one VCN per environment hangs off it as a spoke. A toggle
// replays the route telemetry took before (out of PROD through NAT, round the internet,
// back in through the WAF and the public NLB) and takes now (through the DRG to the
// collector in MGMT). Geometry is built here at build time and motion is CSS, so without
// JS, or with reduced motion, the finished drawing is all there is.
import { Iso, percent, type P3 } from '../../lib/iso';
import { cloud } from '../../data/cloud';
import { t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;

const iso = new Iso(24);
const r2 = (n: number) => Math.round(n * 100) / 100;
type Faces = { top: string; left: string; right: string };
type Rect = { x: number; y: number; w: number; d: number };

// World layout, in floor units. The DRG is the origin; the spokes run along the axes:
// PROD toward -x (upper left on screen), MGMT toward +x (lower right), HML toward -y
// (upper right) and DEV toward +y (lower left). The internet is a plane raised above
// PROD's outer edge, so the old route visibly climbs out and comes back down.
const vcn = {
  prod: { x: -13, y: -3.4, w: 9.4, d: 5.6 },
  mgmt: { x: 3.4, y: -3, w: 8.4, d: 5.8 },
  hml: { x: -2.1, y: -7, w: 4.2, d: 3.6 },
  dev: { x: -2.1, y: 3.4, w: 4.2, d: 3.6 },
} satisfies Record<string, Rect>;
const grow = (r: Rect, m: number): Rect => ({ x: r.x - m, y: r.y - m, w: r.w + m * 2, d: r.d + m * 2 });
const hub: Rect = { x: -1.6, y: -1.6, w: 3.2, d: 3.2 };
const sky = { x: -14.6, y: -3.1, w: 3.2, d: 4.4, z: 4.2 };
const lane = { before: 0.42, after: -0.42, out: -2.4 };

// Subnets: PROD has a public strip on its outer edge and a private one toward the hub.
const subnets: Rect[] = [
  { x: -12.5, y: -2.9, w: 2.8, d: 4.6 },
  { x: -9.2, y: -2.9, w: 5.1, d: 4.6 },
  { x: 3.9, y: -2.5, w: 7.4, d: 4.8 },
  { x: -1.6, y: -6.5, w: 3.2, d: 2.6 },
  { x: -1.6, y: 3.9, w: 3.2, d: 2.6 },
];
// DRG attachments: a bridge from the hub to each VCN.
const arms: Rect[] = [
  { x: vcn.prod.x + vcn.prod.w, y: -0.85, w: -0.9 - (vcn.prod.x + vcn.prod.w), d: 1.7 },
  { x: 0.9, y: -0.85, w: vcn.mgmt.x - 0.9, d: 1.7 },
  { x: -0.85, y: vcn.hml.y + vcn.hml.d, w: 1.7, d: -0.9 - (vcn.hml.y + vcn.hml.d) },
  { x: -0.85, y: 0.9, w: 1.7, d: vcn.dev.y - 0.9 },
];

const at = {
  nat: [vcn.prod.x, lane.out],
  waf: [-11.9, lane.before],
  pnlb: [-10.6, lane.before],
  inlb: [4.9, lane.after - 0.08],
  collector: [10.3, 0],
  kms: [5.4, 5],
} as const;
const box = (c: readonly [number, number], z: number, w: number, d: number, h: number) => iso.boxAt(c[0], c[1], z, w, d, h);

// Clusters: a base, node pools of nodes, two pods per node. PROD is the largest.
type ClusterSpec = { base: Rect; rows: number[]; cols: number[]; node: [number, number]; pod: number; pods: 'x' | 'y' };
const clusterSpec = {
  prod: { base: { x: -8.75, y: -2.7, w: 4.4, d: 2.45 }, rows: [-2.06, -0.89], cols: [-8.02, -6.55, -5.08], node: [1.3, 0.95], pod: 0.4, pods: 'x' },
  mgmt: { base: { x: 6.1, y: -2.4, w: 2.6, d: 1.25 }, rows: [-1.775], cols: [6.75, 8.05], node: [1.1, 0.95], pod: 0.38, pods: 'x' },
  hml: { base: { x: -1.25, y: -5.95, w: 2.5, d: 1.5 }, rows: [-5.2], cols: [-0.6, 0.6], node: [1.0, 1.1], pod: 0.36, pods: 'y' },
  dev: { base: { x: -1.0, y: 4.55, w: 2.0, d: 1.3 }, rows: [5.2], cols: [-0.48, 0.48], node: [0.8, 0.95], pod: 0.32, pods: 'y' },
} satisfies Record<string, ClusterSpec>;
const BASE_H = 0.28;
const NODE_H = 0.22;
const POD_H = 0.36;
const buildCluster = (c: ClusterSpec) => ({
  base: iso.box(c.base.x, c.base.y, 0, c.base.w, c.base.d, BASE_H),
  nodes: c.rows.flatMap((y) => c.cols.map((x) => iso.boxAt(x, y, BASE_H, c.node[0], c.node[1], NODE_H))),
  pods: c.rows.flatMap((y) => c.cols.flatMap((x) => {
    const off = c.pods === 'x' ? c.node[0] / 4.2 : c.node[1] / 4.2;
    return [-off, off].map((o) => (c.pods === 'x'
      ? iso.boxAt(x + o, y, BASE_H + NODE_H, c.pod, c.pod, POD_H)
      : iso.boxAt(x, y + o, BASE_H + NODE_H, c.pod, c.pod, POD_H)));
  })),
});
const clusters = {
  prod: buildCluster(clusterSpec.prod),
  mgmt: buildCluster(clusterSpec.mgmt),
  hml: buildCluster(clusterSpec.hml),
  dev: buildCluster(clusterSpec.dev),
};

// Hub and edge pieces.
const drg = iso.hex(0, 0, 0, 1.05, 0.72);
const drgMark = iso.circle(0, 0, 0.72, 0.42, 32);
const nat = box(at.nat, 0, 1, 1, 0.7);
const reservedIp = iso.circle(at.nat[0], at.nat[1], 1.45, 0.36, 32);
const waf = iso.box(at.waf[0] - 0.2, at.waf[1] - 0.95, 0, 0.4, 1.9, 1.05);
const wafRibs = [0.35, 0.7].map((z) => iso.line([[at.waf[0] + 0.2, at.waf[1] - 0.95, z], [at.waf[0] + 0.2, at.waf[1] + 0.95, z]])).join('');
const fan = (cx: number, cy: number, z: number, s = 1) => [-0.32, 0, 0.32].map((dy) => iso.line([[cx - 0.5 * s, cy, z], [cx + 0.45 * s, cy + dy * s, z]])).join('');
const pnlb = box(at.pnlb, 0, 1.2, 1.5, 0.42);
const inlb = box(at.inlb, 0, 1.4, 1.05, 0.42);
const inlbFan = fan(...at.inlb, 0.42);
const collector = box(at.collector, 0, 1.9, 1.9, 0.9);
const intake = [-0.3, 0.3].map((dy) => iso.line([[at.collector[0] + 0.95, at.collector[1] + dy, 0.26], [at.collector[0] + 0.95, at.collector[1] + dy, 0.62]])).join('');
const kms = box(at.kms, 0, 1.2, 0.9, 0.9);
const keyhole = iso.line([[at.kms[0] + 0.6, at.kms[1] - 0.05, 0.6], [at.kms[0] + 0.6, at.kms[1] - 0.05, 0.3]]);

// NSGs: dotted footprints around what they guard, one per role.
const nsg = (r: Rect, m = 0.26) => iso.rect(r.x - m, r.y - m, 0, r.w + m * 2, r.d + m * 2);
const around = (c: readonly [number, number], w: number, d: number): Rect => ({ x: c[0] - w / 2, y: c[1] - d / 2, w, d });
const nsgs = [
  clusterSpec.prod.base, clusterSpec.mgmt.base, clusterSpec.hml.base, clusterSpec.dev.base,
  around(at.pnlb, 1.2, 1.5), around(at.inlb, 1.4, 1.05), around(at.collector, 1.9, 1.9),
].map((r) => nsg(r)).join('');

// Telemetry routes, on the floor except where the old one climbs to the internet.
const prodBase = clusterSpec.prod.base;
const routePts = {
  before: [
    [prodBase.x, lane.out, 0],
    [vcn.prod.x, lane.out, 0],
    [vcn.prod.x, lane.out, sky.z],
    [vcn.prod.x, lane.before, sky.z],
    [vcn.prod.x, lane.before, 0],
    [at.collector[0] - 0.95, lane.before, 0],
  ],
  after: [
    [prodBase.x + prodBase.w, lane.after, 0],
    [at.collector[0] - 0.95, lane.after, 0],
  ],
} satisfies Record<string, P3[]>;

// The apply, in seconds: each piece appears after what it depends on.
const T = {
  compartments: 0,
  vcn: 0.25,
  subnets: 0.5,
  nsg: 0.75,
  drg: 0.95,
  attach: 1.1,
  gw: 1.3,
  ip: 1.4,
  nlb: 1.6,
  waf: 1.75,
  kms: 1.95, // the clusters encrypt with these keys, so they come first
  clusters: 2.15,
  clusterStep: 0.06,
  pools: 2.45,
  pods: 2.55,
  podStep: 0.022,
  collector: 2.95,
  tracks: 3.05,
  route: 3.15, // the new route draws in, the hops on it light, the caption shows
  lit: 3.35,
  status: 3.45,
};
const done = 3.6;
const logAt = [T.compartments + 0.05, T.vcn, T.subnets, T.nsg, T.drg, T.attach, T.gw, T.nlb, T.waf, T.kms, T.clusters, T.pools];

// Screen length of a polyline, for dash patterns in real SVG units.
const screenLength = (pts: readonly P3[]) =>
  pts.slice(1).reduce((sum, pt, i) => {
    const [ax, ay] = iso.at(pts[i]);
    const [bx, by] = iso.at(pt);
    return sum + Math.hypot(bx - ax, by - ay);
  }, 0);

// Dots: a stream of N beads S apart, then a gap longer than the path, slid along it at
// one speed on both routes, so the long way round visibly takes longer. Each box on a
// route lights up when the first bead reaches it.
const SPEED = 300; // SVG units per second
const N = 6;
const S = 15;
const reach = (pts: readonly P3[], k: number, p: P3 = pts[k]) => (4 + screenLength([...pts.slice(0, k + 1), p])) / SPEED;
const B = routePts.before;
const A = routePts.after;

const stream = (pts: readonly P3[]) => {
  const len = screenLength(pts);
  const gap = len + N * S + 10;
  const dash = [...Array.from({ length: N - 1 }, () => `0 ${S}`), `0 ${r2(gap)}`].join(' ');
  const from = (N - 1) * S + 4;
  const to = -(len + 4);
  return {
    d: iso.line(pts),
    dots: `stroke-dasharray:${dash};--from:${from};--to:${r2(to)};--dur:${((from - to) / SPEED).toFixed(2)}s`,
    trace: `--dur:${(len / SPEED).toFixed(2)}s`,
  };
};
const route = { before: stream(B), after: stream(A) };
const s = (n: number) => `${n.toFixed(2)}s`;

// Painter's order, back to front. `hop` marks a box the chosen route passes through; it
// lights when the first bead reaches it.
type Piece = { key: string; faces: Faces[]; detail?: string; at: number; hop?: 'before' | 'after'; lit?: number };
const hexFaces = (h: ReturnType<Iso['hex']>): Faces => ({ top: h.top, right: `${h.sides[0]}${h.sides[1]}`, left: h.sides[2] });
const pieces: Piece[] = [
  { key: 'nat', faces: [nat], at: T.gw, hop: 'before', lit: reach(B, 1, [vcn.prod.x + 0.5, lane.out, 0]) },
  { key: 'waf', faces: [waf], detail: wafRibs, at: T.waf, hop: 'before', lit: reach(B, 4, [at.waf[0] - 0.2, lane.before, 0]) },
  { key: 'pnlb', faces: [pnlb], detail: fan(...at.pnlb, 0.42), at: T.nlb, hop: 'before', lit: reach(B, 4, [at.pnlb[0] - 0.6, lane.before, 0]) },
];
const drgLit = reach(A, 0, [-1.05, lane.after, 0]);
const inlbLit = reach(A, 0, [at.inlb[0] - 0.7, lane.after, 0]);

// Plates and outlines (compartments are the VCNs grown by a margin, plus the hub's).
const cp = grow(vcn.prod, 0.45);
const cd = grow(vcn.dev, 0.45);
const cm = grow(vcn.mgmt, 0.45);
const ch = grow(vcn.hml, 0.45);
const rects = (list: Rect[], z = 0) => list.map((r) => iso.rect(r.x, r.y, z, r.w, r.d)).join('');
const plates = {
  compartments: rects([cp, ch, cd, cm, hub]),
  vcns: rects(Object.values(vcn)),
  subnets: rects(subnets),
  arms: rects(arms),
  sky: iso.rect(sky.x, sky.y, sky.z, sky.w, sky.d),
};

// Everything is drawn: fix the bounds, then lay the floor grid without widening them.
const vb = iso.viewBox(12);
const floor = iso.grid(-19, 15, -12, 12, 1);

// Labels: anchor in world space, the side the text sits on, and when it appears.
// `sm` moves a label on phones, where only names show.
type Place = { pt: P3; side: string };
type Anchor = Place & { at: number; sm?: Place };
const anchors: Record<string, Anchor> = {
  compartments: { pt: [cd.x + cd.w, cd.y + cd.d, 0], side: 'below-l', at: T.compartments },
  prod: { pt: [-8, cp.y + cp.d, 0], side: 'below', at: T.vcn },
  hml: { pt: [ch.x + ch.w, ch.y + ch.d * 0.45, 0], side: 'right', at: T.vcn },
  dev: { pt: [cd.x, cd.y + cd.d * 0.55, 0], side: 'left', at: T.vcn },
  mgmt: { pt: [6.2, cm.y, 0], side: 'above-r', at: T.vcn, sm: { pt: [8.6, cm.y, 0], side: 'above-r' } },
  drg: { pt: [0.75, 0.75, 0], side: 'below', at: T.drg },
  internet: { pt: [sky.x + sky.w, sky.y, sky.z], side: 'right', at: T.gw },
  // Right of the reserved-IP ring: the left of the NAT is where the old route comes back down.
  nat: { pt: [at.nat[0] + 0.3, at.nat[1] - 0.3, 1.75], side: 'right', at: T.ip },
  waf: { pt: [at.waf[0] - 0.2, at.waf[1] + 0.95, 0.55], side: 'left', at: T.waf, sm: { pt: [at.waf[0] + 0.5, at.waf[1] + 0.95, 0.55], side: 'left' } },
  pnlb: { pt: [at.pnlb[0] + 0.2, at.pnlb[1] + 0.75, 0], side: 'below-l', at: T.nlb, sm: { pt: [at.pnlb[0] + 0.6, at.pnlb[1] + 0.75, 0], side: 'below' } },
  inlb: { pt: [at.inlb[0], at.inlb[1] - 0.53, 0.42], side: 'above', at: T.nlb + 0.05 },
  kms: { pt: [at.kms[0] + 0.6, at.kms[1] + 0.45, 0], side: 'below', at: T.kms },
  collector: { pt: [at.collector[0] + 0.95, at.collector[1] + 0.95, 0], side: 'below', at: T.collector },
};
const labels = cloud.pieces.map((piece) => {
  const a = anchors[piece.key];
  const place = (p: Place | undefined, tier: string) => {
    if (!p) return { vars: [], cls: undefined };
    const pos = percent(iso, vb, p.pt);
    return { vars: [`--x${tier}:${pos.left}`, `--y${tier}:${pos.top}`], cls: tier ? `${tier}-${p.side}` : p.side };
  };
  const base = place(a, '');
  const sm = place(a.sm, 's');
  const style = [...base.vars, ...sm.vars, `--at:${s(a.at)}`].join(';');
  return { ...piece, classes: [base.cls, sm.cls].filter(Boolean), style };
});
const maxStageW = Math.round((560 * vb.w) / vb.h);
const faceList = (b: Faces) => [['l', b.left], ['r', b.right], ['t', b.top]] as const;
const order = ['hml', 'prod', 'dev', 'mgmt'] as const;
const clusterAt = (key: (typeof order)[number]) => T.clusters + order.indexOf(key) * T.clusterStep;
---
<figure class="cloud is-after" data-cloud aria-label={t(cloud.figure, locale)} style={`--tracks:${s(T.tracks)};--route:${s(T.route)};--lit-in:${s(T.lit)};--status:${s(T.status)}`}>
  <div class="plot">
    <div class="stage" style={`aspect-ratio:${vb.w} / ${vb.h};max-width:${maxStageW}px`}>
      <svg viewBox={vb.attr} aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id="cloud-floor-fade" cx="48%" cy="55%" r="56%">
            <stop offset="0.3" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
          </radialGradient>
          <mask id="cloud-floor-mask"><rect x={vb.x} y={vb.y} width={vb.w} height={vb.h} fill="url(#cloud-floor-fade)" /></mask>
        </defs>
        <path class="floor" d={floor} mask="url(#cloud-floor-mask)" />

        <path class="plate compartment" d={plates.compartments} style={`--at:${s(T.compartments)}`} />
        <path class="plate vcn" d={plates.vcns} style={`--at:${s(T.vcn)}`} />
        <path class="plate subnet" d={plates.subnets} style={`--at:${s(T.subnets)}`} />
        <path class="plate nsg" d={nsgs} style={`--at:${s(T.nsg)}`} />
        <path class="plate arm" d={plates.arms} style={`--at:${s(T.attach)}`} />
        <path class="plate sky" d={plates.sky} style={`--at:${s(T.gw)}`} />

        {(['before', 'after'] as const).map((key) => (
          <g class:list={['route', key]}>
            <path class="track" d={route[key].d} />
            <path class="live" d={route[key].d} pathLength="100" style={route[key].trace} />
            <path class="dots" d={route[key].d} style={route[key].dots} />
          </g>
        ))}
        <path class="ring" d={reservedIp} style={`--at:${s(T.ip)}`} />

        {pieces.map((piece) => (
          <g class:list={['obj', piece.hop && `hop-${piece.hop}`]} style={`--at:${s(piece.at)}${piece.lit ? `;--lit:${s(piece.lit)}` : ''}`}>
            {piece.faces.flatMap((b) => faceList(b).map(([cls, d]) => <path class={cls} d={d} />))}
            {piece.detail && <path class="rib" d={piece.detail} />}
          </g>
        ))}

        {(['hml', 'prod'] as const).map((key) => (
          <g class="obj" style={`--at:${s(clusterAt(key))}`}>
            {faceList(clusters[key].base).map(([cls, d]) => <path class={cls} d={d} />)}
            <g class="pool" style={`--at:${s(T.pools + order.indexOf(key) * 0.04)}`}>
              {clusters[key].nodes.flatMap((node) => faceList(node).map(([cls, d]) => <path class={cls} d={d} />))}
            </g>
            {clusters[key].pods.map((pod, i) => (
              <g class:list={['pod', key !== 'prod' && 'quiet']} style={`--at:${s(T.pods + order.indexOf(key) * 0.05 + i * T.podStep)}`}>{faceList(pod).map(([cls, d]) => <path class={cls} d={d} />)}</g>
            ))}
          </g>
        ))}

        <g class="obj hop-after" style={`--at:${s(T.drg)};--lit:${s(drgLit)}`}>
          {faceList(hexFaces(drg)).map(([cls, d]) => <path class={cls} d={d} />)}
          <path class="rib" d={drgMark} />
        </g>

        <g class="obj hop-after" style={`--at:${s(T.nlb + 0.05)};--lit:${s(inlbLit)}`}>
          {faceList(inlb).map(([cls, d]) => <path class={cls} d={d} />)}
          <path class="rib" d={inlbFan} />
        </g>

        {(['dev', 'mgmt'] as const).map((key) => (
          <g class="obj" style={`--at:${s(clusterAt(key))}`}>
            {faceList(clusters[key].base).map(([cls, d]) => <path class={cls} d={d} />)}
            <g class="pool" style={`--at:${s(T.pools + order.indexOf(key) * 0.04)}`}>
              {clusters[key].nodes.flatMap((node) => faceList(node).map(([cls, d]) => <path class={cls} d={d} />))}
            </g>
            {clusters[key].pods.map((pod, i) => (
              <g class="pod quiet" style={`--at:${s(T.pods + order.indexOf(key) * 0.05 + i * T.podStep)}`}>{faceList(pod).map(([cls, d]) => <path class={cls} d={d} />)}</g>
            ))}
          </g>
        ))}

        <g class="obj collector" style={`--at:${s(T.collector)}`}>
          {faceList(collector).map(([cls, d]) => <path class={cls} d={d} />)}
          <path class="rib" d={intake} />
        </g>

        <g class="obj" style={`--at:${s(T.kms)}`}>
          {faceList(kms).map(([cls, d]) => <path class={cls} d={d} />)}
          <path class="rib" d={keyhole} />
        </g>
      </svg>

      <ul class="labels" role="list" aria-hidden="true">
        {labels.map((label) => (
          <li class:list={['label-pin', label.key, ...label.classes]} style={label.style}>
            <strong>{label.prefix && <span class="pre">{label.prefix}&nbsp;</span>}{t(label.name, locale)}</strong>
            {label.detail && <span>{t(label.detail, locale)}</span>}
          </li>
        ))}
      </ul>
    </div>

    <ol class="log" role="list" aria-hidden="true">
      <li class="cmd" style="--at:0s">$ terraform apply</li>
      {cloud.log.map((type, i) => <li style={`--at:${s(logAt[i])}`}><span class="plus">+</span>&nbsp;<Fragment set:html={type.replaceAll('_', '_<wbr>')} /></li>)}
      <li class="end" style={`--at:${s(done)}`}>{cloud.logDone}</li>
    </ol>
  </div>

  <figcaption class="bar">
    <div class="caption">
      <ol role="list" class="visually-hidden">
        {cloud.pieces.map((piece) => <li>{piece.prefix && `${piece.prefix} `}{t(piece.name, locale)}{piece.detail && ` (${t(piece.detail, locale)})`}</li>)}
      </ol>
      <span class="status">
        <span class="dot" aria-hidden="true"></span>
        <span class="msg" aria-live="polite" data-before={t(cloud.status.before, locale)} data-after={t(cloud.status.after, locale)}>{t(cloud.status.after, locale)}</span>
      </span>
    </div>

    <div class="controls" role="group" aria-labelledby="cloud-route-label">
      <span id="cloud-route-label" class="controls-label">{t(cloud.route.label, locale)}</span>
      <button type="button" data-route="before" aria-pressed="false">{t(cloud.route.before, locale)}</button>
      <button type="button" data-route="after" aria-pressed="true">{t(cloud.route.after, locale)}</button>
    </div>
  </figcaption>
</figure>

<script is:inline>
  // The apply starts when the drawing scrolls into view. Inline, right after the figure,
  // so it is armed (paused on its first frame) before first paint and the finished state
  // never flashes first. Without JS the finished state shows.
  (function () {
    var fig = document.currentScript.previousElementSibling;
    if (!fig || !fig.matches('[data-cloud]')) return;
    var stage = fig.querySelector('.stage');
    var msg = fig.querySelector('.msg');
    var buttons = Array.prototype.slice.call(fig.querySelectorAll('[data-route]'));
    var play = function () { fig.classList.add('is-playing'); };

    fig.classList.add('is-armed');
    if ('IntersectionObserver' in window && stage) {
      var io = new IntersectionObserver(function (entries) {
        if (entries.some(function (entry) { return entry.isIntersecting; })) { play(); io.disconnect(); }
      }, { threshold: 0.35 });
      io.observe(stage);
    } else {
      play();
    }

    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        var mode = button.dataset.route === 'before' ? 'before' : 'after';
        fig.classList.remove('is-routing', 'is-before', 'is-after');
        void fig.offsetWidth;
        fig.classList.add('is-routing', 'is-' + mode);
        play();
        buttons.forEach(function (other) { other.setAttribute('aria-pressed', String(other === button)); });
        if (msg) msg.textContent = msg.dataset[mode] || msg.textContent;
      });
    });
  })();
</script>

<style>
  .cloud {
    --face-t: #23221f;
    --face-l: #141412;
    --face-r: #1a1917;
    --edge: #5a574f;
