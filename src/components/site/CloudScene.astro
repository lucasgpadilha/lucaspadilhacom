  .log .plus { color: var(--signal); }
  .log .end { color: var(--ink); }
  /* The log fills the empty top right of the drawing when there is room for it, and
     sits below the drawing otherwise, in two columns when they fit. */
  @container (min-width: 600px) {
    .log { columns: 2; column-gap: 1.5rem; max-width: 32rem; }
  }
  @container (min-width: 790px) {
    .stage { margin-inline: 0; }
    .log { position: absolute; top: 0; right: 0; width: 32rem; }
