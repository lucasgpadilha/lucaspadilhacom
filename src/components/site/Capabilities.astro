---
import { capabilities } from '../../data/home';
import { t, type Locale } from '../../lib/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="zone-night capabilities" aria-labelledby="capabilities-title">
  <div class="wrap">
    <h2 id="capabilities-title">{t(capabilities.title, locale)}</h2>
    <ul role="list">
      {capabilities.items.map((item) => (
        <li>
          {item.href ? <a href={item.href}>{t(item.name, locale)}</a> : <b>{t(item.name, locale)}</b>}
          <p>{t(item.body, locale)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* An index, not a row of cards: names and one line each, joined by a single rule. */
  .capabilities { padding-block: 0 clamp(2.5rem, 2rem + 2vw, 3.5rem); }
  h2 { font-size: 1rem; font-weight: 620; letter-spacing: -0.01em; margin-bottom: 0.9rem; color: var(--ink-2); }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 1.5rem; margin: 0; padding: 1rem 0 0; border-top: 1px solid var(--line-strong); }
  li { display: grid; gap: 0.3rem; align-content: start; }
  li :is(a, b) { font-weight: 620; font-size: 0.9375rem; color: var(--ink); width: fit-content; }
  li a { text-decoration-color: var(--signal); }
  p { font-size: 0.8125rem; line-height: 1.45; color: var(--ink-2); }
  @media (min-width: 700px) { ul { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1080px) { ul { grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: 1.75rem; } }
</style>
