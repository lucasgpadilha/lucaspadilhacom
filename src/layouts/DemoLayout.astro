---
import DemoBanner from '../components/demos/DemoBanner.astro';
import { absolute } from '../lib/locale';

interface Props {
  title: string;
  description: string;
  slug: 'advocacia' | 'odontologia' | 'cafe';
  themeColor: string;
}

interface Credit {
  name: string;
  title: string;
  author: string;
  license: string;
  license_url: string;
  source_url: string;
}

const { title, description, slug, themeColor } = Astro.props;
const path = `/sites/exemplos/${slug}/`;
const files = import.meta.glob<Credit[]>('../../public/sites/exemplos/*/img/credits.json', { eager: true, import: 'default' });
const credits = files[`../../public/sites/exemplos/${slug}/img/credits.json`] ?? [];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={absolute(path)} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(path)} />
    <meta property="og:image" content={absolute(`/og/demo-${slug}.jpg`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <DemoBanner />
    <slot />
    {credits.length > 0 && (
      <aside class="demo-credits" aria-label="Créditos das fotos">
        <p>
          Fotos do Wikimedia Commons:{' '}
          {credits.map((c, i) => (
            <>
              <a href={c.source_url}>{c.title}</a>, por {c.author} (<a href={c.license_url}>{c.license}</a>){i < credits.length - 1 ? '; ' : '.'}
            </>
          ))}
          {' '}Fotos recortadas, ajustadas e convertidas para a web. Empresa, nomes e textos são fictícios.
        </p>
      </aside>
    )}
  </body>
</html>

<style is:global>
  .demo-credits {
    padding: 20px 16px 28px; background: #141413; color: #a29f97;
    font: 400 12px/1.6 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  .demo-credits p { max-width: 1200px; margin: 0 auto; }
  .demo-credits a { color: #ece9e1; }
</style>
