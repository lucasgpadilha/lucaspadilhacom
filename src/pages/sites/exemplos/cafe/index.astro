---
/*
 * Casa Jabuticaba (fictional artisan bakery and café, Barão Geraldo, Campinas – SP)
 * Palette: jabuticaba #2B1530 (dark grounds, display ink) · creme #F6EEDF (paper) · crosta #C8582F (terracotta, large type and dots only)
 *   · crosta-texto #A8461F (small terracotta text, 5.1:1 on creme) · folha #3F6B3A (leaf-green ground, cream text 5.4:1) · tinta #2A1A1F (body, 14.4:1).
 * Type: Fraunces Variable with all axes, SOFT 100 + WONK 1 + optical sizing, for a doughy, slightly wonky display; DM Sans Variable for body and UI.
 * Layout: an oversized three-line headline beside an arch-framed photo (the mouth of the oven), overlapped by a round coffee crop, a spinning stamp and a price tag.
 * Signature: the jabuticaba dot, a glossy purple-black circle used as full stop, brand mark, bullet, "queridinho" marker and photo frame;
 *   carried by a hand-set paper menu with round dotted leaders.
 * Rhythm: creme hero, terracotta ribbon, paper menu, leaf-green bake times, cake orders, jabuticaba visit, FAQ, jabuticaba footer.
 */
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/dm-sans';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import DemoLayout from '../../../../layouts/DemoLayout.astro';
import Header from '../../../../components/demos/cafe/Header.astro';
import Hero from '../../../../components/demos/cafe/Hero.astro';
import Faixa from '../../../../components/demos/cafe/Faixa.astro';
import Cardapio from '../../../../components/demos/cafe/Cardapio.astro';
import Fornadas from '../../../../components/demos/cafe/Fornadas.astro';
import Encomendas from '../../../../components/demos/cafe/Encomendas.astro';
import Visite from '../../../../components/demos/cafe/Visite.astro';
import Faq from '../../../../components/demos/cafe/Faq.astro';
import Footer from '../../../../components/demos/cafe/Footer.astro';
---
<DemoLayout
  title="Casa Jabuticaba · Padaria e café em Barão Geraldo, Campinas"
  description="Pão de fermentação natural, pão de queijo de verdade, cafés especiais e bolos de vó em Barão Geraldo, Campinas – SP. Fornadas do dia, encomendas e delivery na região."
  slug="cafe"
  themeColor="#2B1530"
>
  <link slot="head" rel="preload" as="font" type="font/woff2" href={frauncesLatin} crossorigin />
  <a class="cj-skip" href="#conteudo">Pular para o conteúdo</a>
  <div id="topo" class="cj-page">
    <Header />
    <main id="conteudo">
      <Hero />
      <Faixa />
      <Cardapio />
      <Fornadas />
      <Encomendas />
      <Visite />
      <Faq />
    </main>
    <Footer />
  </div>
</DemoLayout>

<style is:global>
  :root {
    --jabuticaba: #2B1530;
    --creme: #F6EEDF;
    --papel: #FBF6EC;
    --miolo: #EEE2CB;
    --crosta: #C8582F;
    --crosta-texto: #A8461F;
    --crosta-clara: #E8875C;
    --folha: #3F6B3A;
    --tinta: #2A1A1F;
    --tinta-2: #5E4B47;
    --lilas: #C9B3CF;
    --display: 'Fraunces Variable', Georgia, 'Times New Roman', serif;
    --sans: 'DM Sans Variable', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --gutter: 20px;
    --maxw: 1320px;
    color-scheme: light;
  }
  @media (max-width: 359px) { :root { --gutter: 16px; } }
  @media (min-width: 760px) { :root { --gutter: 40px; } }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; scroll-padding-top: 60px; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  body {
    margin: 0; background: var(--creme); color: var(--tinta);
    font: 400 1.0625rem/1.6 var(--sans); font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
  }
  :where(.cj-page) :where(h1, h2, h3, p, ul, ol, dl, dd, figure) { margin: 0; }
  :where(.cj-page) :where(h1, h2, h3) { text-wrap: balance; }
  :where(.cj-page) :where(p) { text-wrap: pretty; }
  :where(.cj-page) :where(img) { display: block; max-width: 100%; height: auto; }
  :where(.cj-page) :where(a) { color: inherit; }
  main { overflow-x: clip; }

  .cj-page :focus-visible { outline: 3px solid var(--crosta-texto); outline-offset: 3px; border-radius: 3px; }
  .cj-dark :focus-visible { outline-color: var(--creme) !important; }

  .cj-skip {
    position: absolute; left: 12px; top: 52px; z-index: 1001; display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem;
    background: var(--jabuticaba); color: var(--creme); font: 600 1rem/1 var(--sans); border-radius: 0.5rem;
    transform: translateY(-200%); opacity: 0;
  }
  .cj-skip:focus { transform: none; opacity: 1; outline: 3px solid var(--crosta); outline-offset: 2px; }

  .cj-wrap { width: min(100% - 2 * var(--gutter), var(--maxw)); margin-inline: auto; }
  .cj-sr { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* The jabuticaba: a glossy purple-black dot. */
  .cj-dot {
    --dot: var(--jabuticaba);
    display: inline-block; width: 1rem; height: 1rem; border-radius: 50%;
    background: radial-gradient(circle at 33% 30%, rgb(255 255 255 / 0.7) 0 7%, rgb(255 255 255 / 0) 15%) var(--dot);
  }

  .cj-eyebrow { font: 650 0.8125rem/1.35 var(--sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--folha); }
  .cj-h2 {
    margin-top: 0.75rem;
    font-family: var(--display); font-weight: 620; color: var(--jabuticaba);
    font-size: clamp(2.75rem, 1.5rem + 5.2vw, 5.75rem); line-height: 0.95; letter-spacing: -0.035em;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }
  .cj-dark .cj-h2 { color: var(--creme); }
  .cj-lead { margin-top: 1.25rem; max-width: 34rem; font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem); line-height: 1.55; }

  .cj-btn {
    display: inline-flex; align-items: center; gap: 0.65rem; min-height: 54px; padding: 0 1.4rem 0 1.6rem;
    border-radius: 999px; background: var(--jabuticaba); color: var(--creme);
    font: 600 1.0625rem/1 var(--sans); letter-spacing: 0.005em; text-decoration: none;
    box-shadow: 0 0 0 0 var(--crosta); transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }
  .cj-btn svg { flex: none; transition: translate 0.2s ease; }
  .cj-btn:hover { background: var(--crosta-texto); }
  .cj-btn:hover svg { translate: 3px 0; }
  .cj-btn--light { background: var(--creme); color: var(--jabuticaba); }
  .cj-btn--light:hover { background: var(--crosta-clara); }
  .cj-textlink {
    display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--jabuticaba);
    text-decoration: underline; text-decoration-color: var(--crosta); text-decoration-thickness: 2px; text-underline-offset: 0.32em;
  }
  .cj-textlink:hover { text-decoration-color: var(--jabuticaba); }
  .cj-demo-note { max-width: 30rem; font-size: 0.8125rem; line-height: 1.45; color: var(--tinta-2); }

  /* Hand-set price list with round dotted leaders. */
  .cj-menu { margin: 0; padding: 0; list-style: none; display: grid; gap: 1rem; }
  .cj-line { display: flex; align-items: last baseline; gap: 0.35rem; }
  .cj-name {
    font-family: var(--display); font-weight: 580; font-size: clamp(1rem, 0.85rem + 0.6vw, 1.1875rem); line-height: 1.2; color: var(--jabuticaba);
    font-variation-settings: 'SOFT' 50, 'WONK' 0;
  }
  .cj-dark .cj-name { color: var(--creme); }
  .cj-leader {
    flex: 1 1 1rem; min-width: 1rem; height: 4px; translate: 0 -0.22em; opacity: 0.6;
    background: radial-gradient(circle, currentColor 1.15px, transparent 1.65px) 0 50% / 7px 4px repeat-x;
  }
  .cj-price {
    white-space: nowrap; font-family: var(--display); font-weight: 640; font-size: 1.25rem; line-height: 1.2; color: var(--crosta-texto);
    font-variant-numeric: lining-nums tabular-nums; font-variation-settings: 'SOFT' 100, 'WONK' 0;
  }
  .cj-price small { margin-right: 0.12em; font: 650 0.6em/1 var(--sans); vertical-align: 0.32em; color: var(--tinta-2); }
  .cj-from { font: 500 0.8125rem/1 var(--sans); color: var(--tinta-2); }
  .cj-dark .cj-from, .cj-dark .cj-price small { color: var(--lilas); }
  .cj-desc { margin-top: 0.2rem; max-width: 30em; padding-right: clamp(1rem, 4vw, 2.5rem); font-size: 0.9375rem; line-height: 1.45; color: var(--tinta-2); }

  /* Photo slots while a photo is missing: a field of jabuticaba dots. */
  .cj-ph { display: block; width: 100%; height: 100%; min-height: 6rem; background: radial-gradient(circle at 35% 35%, rgb(246 238 223 / 0.3) 0 22%, transparent 24%) 0 0 / 26px 26px, var(--tone, var(--miolo)); }
  .cj-ph--crosta { --tone: var(--crosta); }
  .cj-ph--folha { --tone: var(--folha); }
  .cj-ph--jabuticaba { --tone: #4a2a52; }
  .cj-ph--miolo { --tone: var(--miolo); }

  @media (prefers-reduced-motion: reduce) {
    .cj-page *, .cj-page *::before, .cj-page *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  }
</style>
