---
/*
 * Lacerda & Viana Advocacia — art direction
 * Palette: ink #14231D (green-black), paper #F4EFE4 (ivory), brass #A8834C (rules, numerals and
 *   type >= 24px only: 3.04:1 on paper, 4.67:1 on ink), muted #56625B (5.56:1 on paper),
 *   muted-on-ink #A9B1A4 (7.39:1).
 * Type: Newsreader Variable with optical sizing (opsz 72 for display, ~18 for reading) and its
 *   italic for the accent words; Manrope Variable for nav, labels, buttons and small print.
 * Layout: an asymmetric 12-column editorial grid, set like a legal journal: a masthead with a
 *   section bar, sections numbered as paragraphs of a statute (§ 1º, § 2º…), practice areas as a
 *   numbered index on hairlines, steps numbered as incisos (I–IV) on an ink band.
 * Signature: brass hairlines that draw in, a brass italic ampersand as the only "logo", photos as
 *   ink-to-ivory duotones inside a thin passe-partout, and footnotes that cite the actual law.
 */
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/manrope';
import serifUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import DemoLayout from '../../../../layouts/DemoLayout.astro';
import Masthead from '../../../../components/demos/advocacia/Masthead.astro';
import Hero from '../../../../components/demos/advocacia/Hero.astro';
import Areas from '../../../../components/demos/advocacia/Areas.astro';
import Publico from '../../../../components/demos/advocacia/Publico.astro';
import Conversa from '../../../../components/demos/advocacia/Conversa.astro';
import Escritorio from '../../../../components/demos/advocacia/Escritorio.astro';
import Perguntas from '../../../../components/demos/advocacia/Perguntas.astro';
import Contato from '../../../../components/demos/advocacia/Contato.astro';
import Rodape from '../../../../components/demos/advocacia/Rodape.astro';
---
<DemoLayout
  title="Lacerda & Viana Advocacia · Trabalho e Família em Campinas"
  description="Escritório de advocacia no Cambuí, em Campinas – SP, com atuação em direito do trabalho e direito de família. Atendimento presencial e online em todo o Brasil."
  slug="advocacia"
  themeColor="#14231D"
>
  <link slot="head" rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
  <div class="lv">
    <Masthead />
    <main id="conteudo" tabindex="-1">
      <Hero />
      <Areas />
      <Publico />
      <Conversa />
      <Escritorio />
      <Perguntas />
      <Contato />
    </main>
    <Rodape />
  </div>
</DemoLayout>

<style is:global>
  :root {
    --lv-ink: #14231d;
    --lv-ink-2: #1d3229;
    --lv-paper: #f4efe4;
    --lv-paper-deep: #ebe4d4;
    --lv-brass: #a8834c;
    --lv-muted: #56625b;
    --lv-on-ink: #f4efe4;
    --lv-on-ink-muted: #a9b1a4;
    --lv-rule: rgba(20, 35, 29, 0.16);
    --lv-rule-strong: rgba(20, 35, 29, 0.32);
    --lv-serif: 'Newsreader Variable', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
    --lv-sans: 'Manrope Variable', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    --lv-gutter: 20px;
    --lv-maxw: 1360px;
    --lv-t-label: 0.75rem;
    --lv-t-ui: 0.9375rem;
    --lv-t-body: clamp(1.0625rem, 1rem + 0.22vw, 1.1875rem);
    --lv-t-lede: clamp(1.1875rem, 1.04rem + 0.62vw, 1.5rem);
    --lv-t-h3: clamp(1.375rem, 1.18rem + 0.8vw, 1.875rem);
    --lv-t-h2: clamp(2.125rem, 1.38rem + 3.3vw, 4.5rem);
    --lv-t-h1: clamp(2.5rem, 1.45rem + 5.25vw, 6.5rem);
    --lv-ease: cubic-bezier(0.22, 0.61, 0.24, 1);
    color-scheme: light;
  }
  @media (min-width: 720px) { :root { --lv-gutter: 36px; } }
  @media (min-width: 1200px) { :root { --lv-gutter: 56px; } }
  @media (min-width: 1680px) { :root { --lv-maxw: 1480px; } }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; scroll-padding-top: 64px; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  body {
    margin: 0; background: var(--lv-paper); color: var(--lv-ink);
    -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
  }
  .lv {
    font-family: var(--lv-serif); font-size: var(--lv-t-body); line-height: 1.6;
    font-optical-sizing: auto; font-kerning: normal; text-rendering: optimizeLegibility;
    overflow-x: clip;
  }
  .lv :where(h1, h2, h3, h4, p, ul, ol, dl, dd, figure, blockquote) { margin: 0; }
  .lv :where(ul, ol)[role='list'] { list-style: none; padding: 0; }
  .lv :where(h1, h2, h3) { font-weight: 380; line-height: 1.06; letter-spacing: -0.012em; text-wrap: balance; }
  .lv p { text-wrap: pretty; }
  .lv img { display: block; max-width: 100%; height: auto; }
  .lv em { font-style: italic; }
  .lv a { color: inherit; text-decoration-line: underline; text-decoration-thickness: 1px; text-underline-offset: 0.22em; text-decoration-color: var(--lv-brass); }
  .lv a:hover { text-decoration-thickness: 2px; }
  .lv :focus-visible { outline: 2px solid var(--lv-ink); outline-offset: 3px; }
  .lv ::selection { background: var(--lv-ink); color: var(--lv-paper); }
  .lv main:focus { outline: none; }

  .lv-skip {
    position: absolute; left: 12px; top: 56px; z-index: 1001;
    width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
    padding: 14px 18px; background: var(--lv-ink); color: var(--lv-paper) !important;
    font: 600 var(--lv-t-ui)/1 var(--lv-sans); text-decoration: none !important;
  }
  .lv-skip:focus { width: auto; height: auto; clip-path: none; outline: 2px solid var(--lv-brass); outline-offset: 2px; }

  .lv-wrap { width: 100%; max-width: var(--lv-maxw); margin-inline: auto; padding-inline: var(--lv-gutter); }

  /* Small labels: Manrope capitals, tracked; never brass (small text fails on ivory). */
  .lv-label {
    font-family: var(--lv-sans); font-size: var(--lv-t-label); font-weight: 650; line-height: 1.4;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--lv-muted);
  }
  .lv-dark .lv-label { color: var(--lv-on-ink-muted); }

  .lv-lede { font-size: var(--lv-t-lede); line-height: 1.5; color: var(--lv-muted); max-width: 34em; }
  .lv-dark .lv-lede { color: var(--lv-on-ink-muted); }

  /* Brass hairline that draws itself in once, from the left. */
  .lv-rule { display: block; height: 1px; background: var(--lv-brass); border: 0; margin: 0; transform-origin: 0 50%; }
  @media (prefers-reduced-motion: no-preference) {
    .lv-rule--hero { animation: lv-draw 1.1s var(--lv-ease) 0.15s both; }
    @supports (animation-timeline: view()) {
      .lv-rule--scroll { animation: lv-draw linear both; animation-timeline: view(); animation-range: entry 0% cover 25%; }
    }
  }
  @keyframes lv-draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .lv-dark { background: var(--lv-ink); color: var(--lv-on-ink); }
  .lv-dark :focus-visible { outline-color: var(--lv-paper); }
  .lv-dark ::selection { background: var(--lv-paper); color: var(--lv-ink); }
</style>
